# The Zephyr workspace: fetched and built by zephyr/script/setup.sh and west.
/zephyr/.venv/
/zephyr/.west/
/zephyr/.cmake/
/zephyr/.wget-hsts
/zephyr/zephyr/
/zephyr/zephyr-sdk-*/
/zephyr/modules/
/zephyr/bootloader/
/zephyr/tools/
/zephyr/doc/
/zephyr/build/

# The NuttX workspace: fetched by nuttx/script/setup.sh.
/nuttx/nuttx/
/nuttx/nuttx-apps/
/nuttx/nuttx.tmp/
/nuttx/nuttx-apps.tmp/
/nuttx/pico-sdk/
/nuttx/pico-sdk.tmp/
/nuttx/stmemsc/
/nuttx/toolchain/
/nuttx/.venv/
# Files generated by the NuttX build in the out-of-tree directories.
/nuttx/drivers/**/*.o
/nuttx/drivers/**/*.a
/nuttx/drivers/**/.depend
/nuttx/drivers/**/Make.dep
/nuttx/drivers/**/.built
/nuttx/drivers/**/.kconfig
/nuttx/apps/**/*.o
/nuttx/apps/**/*.a
/nuttx/apps/**/.depend
/nuttx/apps/**/Make.dep
/nuttx/apps/**/.built
/nuttx/apps/**/.kconfig
/nuttx/apps/Kconfig
/nuttx/boards/**/*.o
/nuttx/boards/**/*.a
/nuttx/boards/**/.depend
/nuttx/boards/**/Make.dep
/nuttx/boards/**/.built
/nuttx/boards/**/etctmp/
/nuttx/boards/**/etctmp.c
/nuttx/boards/**/romfs.img
/nuttx/boards/**/*.ld.tmp
# Output of nuttx/script/build.sh.
/nuttx/build/

# The OpenMV (MicroPython) workspace: fetched by openmv/script/setup.sh.
/openmv/openmv/
/openmv/openmv.tmp/
/openmv/openmv-sdk-*/
/openmv/.download/
# Output of openmv/script/build.sh.
/openmv/build/

# The Pico SDK + FreeRTOS workspace: fetched by freertos/script/setup.sh.
/freertos/pico-sdk/
/freertos/pico-sdk.tmp/
/freertos/FreeRTOS-Kernel/
/freertos/FreeRTOS-Kernel.tmp/
/freertos/toolchain/
/freertos/.venv/
/freertos/stmemsc/
# picotool's source, fetched by the Pico SDK at the first build.
/freertos/picotool/
# Output of freertos/script/build.sh.
/freertos/build/

# The Pico SDK + ThreadX workspace: fetched by threadx/script/setup.sh.
/threadx/threadx/
/threadx/threadx.tmp/
/threadx/pico-sdk/
/threadx/pico-sdk.tmp/
/threadx/toolchain/
/threadx/.venv/
# picotool's source, fetched by the Pico SDK at the first build.
/threadx/picotool/
# Output of threadx/script/build.sh.
/threadx/build/
