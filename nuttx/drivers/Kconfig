#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#
# Kernel-side code of the Nano RP2040 Connect port.  nuttx/nuttx/external is
# a symlink to this directory; NuttX sources this file at the end of its
# top-level Kconfig (outside any menu) and links libexternal.a built by
# ./Makefile.  Each subdirectory with options has its own Kconfig, sourced
# at the end of this file.
#

config NANO_LOG_RAM
	bool "RAM log (dmesg) and the LOG_* macros"
	default y
	depends on SYSLOG
	select SYSLOG_REGISTER
	---help---
		log/log_ram.c: a 4096-byte ring buffer in .noinit that survives
		a reset (Zephyr build: src/log_ram.c).  The LOG_* macros of
		include/app_log.h write lines to it, and it is registered as the
		syslog channel, so syslog() output goes there too.  The "dmesg"
		command (nuttx/apps/dmesg) prints it.  The board calls
		log_ram_initialize() from rp2040_boardinitialize().

if NANO_LOG_RAM

config NANO_LOG_DEFAULT_LEVEL
	int "Default log level"
	default 3
	range 0 4
	---help---
		Level of a module registered with LOG_MODULE_REGISTER(name) and
		no level (0 none, 1 err, 2 wrn, 3 inf, 4 dbg).  Zephyr build:
		CONFIG_LOG_DEFAULT_LEVEL=3.

config NANO_LOG_MAX_LEVEL
	int "Maximum log level compiled in"
	default 4
	range 0 4
	---help---
		Messages above this level are left out of every module.  Zephyr
		build: CONFIG_LOG_MAX_LEVEL=4.

endif # NANO_LOG_RAM

rsource "nina/Kconfig"
