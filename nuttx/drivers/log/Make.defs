############################################################################
# nuttx/drivers/log/Make.defs
#
# The RAM log: its shared part (log_ram.c on log_ring.c, in common/compat/log,
# headers in common/compat/include, internal and port, which the host tests
# also build) and its NuttX part, the syslog channel (log_ram_syslog.c,
# with log_ram_os_impl.h of the boundary, in common/compat/port/nuttx).
# Included by nuttx/drivers/Makefile.  VPATH and DEPPATH are relative to
# nuttx/drivers (mkdeps needs relative ones); the objects are made there.
############################################################################

ifeq ($(CONFIG_LOG_RAM),y)
CSRCS += log_ram.c log_ram_syslog.c log_ring.c
DEPPATH += --dep-path ../../common/compat/port/nuttx
VPATH += :../../common/compat/port/nuttx
DEPPATH += --dep-path ../../common/compat/log
VPATH += :../../common/compat/log
endif
