############################################################################
# nuttx/drivers/i2c_dw/Make.defs
#
# The I2C driver of I2C0 (the LSM6DSOX and the ATECC608A) and I2C1, in
# place of the in-tree rp2040_i2c.c (RP2040_I2C off).  Its OS-independent
# core is common/drivers/i2c_dw/i2c_dw.c (one source for both instances);
# its NuttX binding is common/drivers/i2c_dw/port/nuttx: i2c_dw_os_impl.h
# and i2c_dw_instance.h, which the core reads, i2c_dw_controllers_rp2040.h
# (the start of each controller, which the board's bringup reads) and
# i2c_dw_dma_os_rp2040.c, the DMA reads' two channels on NuttX's own DMA
# driver (arch/arm/src/rp2040/rp2040_dmac.c, RP2040_DMAC; the boundary
# common/drivers/i2c_dw/port/i2c_dw_dma_os.h).  The options are the
# board's (CONFIG_I2C_DW_I2C0, _I2C1, _RP2040_DMA).
#
# The binding reads the chip's registers and NuttX's RP2040 functions
# (rp2040_gpio.h, rp2040_dmac.h, arm_internal.h), so the chip's private
# include directories are on the path, as for the board's sources.
############################################################################

ifneq ($(CONFIG_I2C_DW_I2C0)$(CONFIG_I2C_DW_I2C1),)
I2C_DW_DIR = $(TOPDIR)$(DELIM)..$(DELIM)..$(DELIM)common$(DELIM)drivers$(DELIM)i2c_dw

CSRCS += i2c_dw.c
ifeq ($(CONFIG_I2C_DW_RP2040_DMA),y)
CSRCS += i2c_dw_dma_os_rp2040.c
endif

DEPPATH += --dep-path ../../common/drivers/i2c_dw
VPATH += :../../common/drivers/i2c_dw
DEPPATH += --dep-path ../../common/drivers/i2c_dw/port/nuttx
VPATH += :../../common/drivers/i2c_dw/port/nuttx
CFLAGS += ${INCDIR_PREFIX}$(I2C_DW_DIR)$(DELIM)include
CFLAGS += ${INCDIR_PREFIX}$(I2C_DW_DIR)$(DELIM)internal
CFLAGS += ${INCDIR_PREFIX}$(I2C_DW_DIR)$(DELIM)port
CFLAGS += ${INCDIR_PREFIX}$(I2C_DW_DIR)$(DELIM)port$(DELIM)nuttx
endif
