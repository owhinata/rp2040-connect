############################################################################
# nuttx/drivers/nina/Make.defs
#
# The NINA-W102 SPI link (nina_spi.c, a port of the Zephyr build's
# drivers/nina/nina_wifi.c) and its kernel services (nina_os.c); the
# sockets as usrsock (nina_sock.c, nina_usrsock.c, nina_poller.c, from the
# Zephyr build's drivers/nina/nina_socket.c); name resolution with the
# module's resolver (nina_dns.c, from the Zephyr build's
# drivers/nina/nina_dns.c); the Wi-Fi network device wlan0 (nina_net.c,
# shared with the Zephyr build in common/drivers/nina, and nina_netdev.c),
# with the Wi-Fi profile's calls answered by common/imu/wifi_profile.c
# (CONFIG_NANO_WIFI_PROFILE, nuttx/apps/wifi), or by wifi_profile_null.c
# without it.  The board provides the pins and the SPI bus (nano_nina.c,
# <nano_nina.h>).  Included by nuttx/drivers/Makefile.  VPATH and DEPPATH of
# common/drivers/nina are relative to nuttx/drivers (mkdeps needs relative
# ones); the object is made there, compiled with the prelude of the shared
# sources (compat/common_prelude.h).  Include paths: this directory
# ($(TOPDIR)/external/nina: nina_proto.h for nina_net.c) and common/imu
# (wifi_profile.h).
############################################################################

ifeq ($(CONFIG_NANO_NINA),y)
CSRCS += nina_spi.c nina_os.c
ifeq ($(CONFIG_NANO_NINA_USRSOCK),y)
CSRCS += nina_sock.c nina_usrsock.c nina_poller.c
endif
ifeq ($(CONFIG_NANO_NINA_DNS),y)
CSRCS += nina_dns.c
endif
ifeq ($(CONFIG_NANO_NINA_NET),y)
CSRCS += nina_net.c nina_netdev.c
ifneq ($(CONFIG_NANO_WIFI_PROFILE),y)
CSRCS += wifi_profile_null.c
endif
endif
DEPPATH += --dep-path nina
VPATH += :nina
ifeq ($(CONFIG_NANO_NINA_NET),y)
DEPPATH += --dep-path ../../common/drivers/nina
VPATH += :../../common/drivers/nina
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)external$(DELIM)nina
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)..$(DELIM)..$(DELIM)common$(DELIM)imu
nina_net$(OBJEXT): CFLAGS += -include $(TOPDIR)$(DELIM)external$(DELIM)compat$(DELIM)common_prelude.h
endif
endif
