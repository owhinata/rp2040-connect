#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config NINA
	bool "NINA-W102 SPI link (nina_proto_request())"
	default y
	depends on RP2040_SPI1 && !RP2040_SPI_DMA
	depends on LSM6DSO_STREAM
	---help---
		common/drivers/nina/internal/nina_proto.c: nina_proto_request() and nina_proto_ip_config(),
		shared with the Zephyr build (the WiFiNINA SPI protocol of the
		module's Arduino firmware), with the same framing, timeouts,
		error values and lazy initialization (the module is reset on
		the first request).  The board provides SPI1
		and the module's lines (nina_bus_rp2040.c).  SPI1 is polled, as in
		the Zephyr build (CONFIG_SPI_PL022_INTERRUPT and _DMA off), so
		RP2040_SPI_DMA must be off.  The waits for the module's READY
		line (GPIO10) sleep on its edge interrupt
		(common/drivers/nina/port/nuttx/nina_os.c),
		through the compatibility layer's gpio0 and the board's
		src/nano_gpio.c, which are built with LSM6DSO_STREAM.

if NINA

config NINA_SPI_FREQUENCY
	int "NINA SPI frequency in Hz"
	default 8000000
	range 1000000 10000000
	---help---
		The requested SPI clock, the same option as the Zephyr
		build's (default 8000000).  The PL022 divides
		clk_peri (125 MHz) by an even number: 8 MHz gives 7.8125 MHz in
		both builds.

config NINA_USRSOCK
	bool "NINA sockets (usrsock)"
	default y
	depends on NET_USRSOCK_CUSTOM
	---help---
		common/drivers/nina/nina_sock.c, and nina_usrsock.c and
		nina_poller.c of common/drivers/nina/port/nuttx: the socket offload
		of the Zephyr build (common/drivers/nina/port/zephyr/nina_socket.c) as
		NuttX's usrsock (usrsock_request() in the kernel, handled in the
		calling thread), with the same socket table (10 sockets),
		commands, timeouts and errno names.  The thread "nina_event"
		polls the module's sockets and turns their state into usrsock
		events, as the Zephyr build's connect() and poll() poll in
		their callers.

config NINA_TCP_MAX_IO
	int "Maximum bytes per NINA TCP send"
	default 3584
	range 1 3584
	depends on NINA_USRSOCK
	---help---
		The same option as the Zephyr build's.  Bounds each TCP send
		to leave room for framing in the NINA SPI command buffer.  A RAW
		batch of up to 2448 bytes plus its MQTT header is sent in one
		command with the default.

config NINA_SEND_RETRY_MS
	int "Delay before retrying a full NINA TCP send buffer"
	default 1
	range 1 1000
	depends on NINA_USRSOCK
	---help---
		The same option as the Zephyr build's.  A TCP send that
		waits and finds no room in the module is tried again after this
		delay (the event thread reports SENDTO_READY and usrsock repeats
		the request in the caller's thread), until NINA_SEND_WAIT_MS.

config NINA_NET
	bool "NINA Wi-Fi network device wlan0 (ifconfig, wapi)"
	default y
	depends on NINA_USRSOCK && LSM6DSO_STREAM
	depends on DRIVERS_IEEE80211 && NETDEV_WIRELESS_IOCTL && NET_IPv4
	---help---
		nina_wifi.c (common/drivers/nina, shared with the Zephyr build:
		scan, connect, disconnect, status and the 2-second link monitor,
		with its threads nina_scan_tid, nina_connect_tid and
		nina_monitor_tid) and its NuttX binding in
		common/drivers/nina/port/nuttx: nina_netdev.c registers the module as
		the network device wlan0 and turns wapi's wireless ioctls into
		the core's calls; nina_wifi_mgmt.c serves the applications' Zephyr
		Wi-Fi management (NET_REQUEST_WIFI_CONNECT of the stored
		networks, the connection events) on the core.  The IP address,
		netmask, gateway and MAC address are those of wlan0 (ifconfig).
		Uses the Zephyr compatibility layer's kernel objects, which are
		built with LSM6DSO_STREAM, and its net_if, net_mgmt and wifi_mgmt
		parts (the "net_mgmt" event thread).

config NINA_DNS
	bool "Name resolution with the NINA resolver (nina_dns_getaddrinfo())"
	default y
	depends on !LIBC_NETDB
	---help---
		common/drivers/nina/nina_dns.c: nina_dns_getaddrinfo() and nina_dns_freeaddrinfo()
		(<nina_dns.h>), shared with the Zephyr build, which
		resolves a name with the module's commands 0x34 and 0x35 and
		gives one IPv4 address.  The Zephyr compatibility layer's
		zsock_getaddrinfo() uses it.  Not with LIBC_NETDB (NuttX's own
		getaddrinfo()).

endif # NINA

config NINA_PASSTHROUGH
	bool "NINA passthrough mode (nina passthrough confirm)"
	default y
	depends on ARCH_CHIP_RP2040 && CDCACM && BOARD_LATE_INITIALIZE
	depends on !RP2040_UART1 && !SMP
	---help---
		The NINA driver's passthrough mode
		(common/drivers/nina/nina_passthrough.c, shared with the Zephyr
		and FreeRTOS builds; its NuttX side
		common/drivers/nina/port/nuttx/nina_passthrough_os.c, its module side
		port/nuttx/nina_passthrough_bus_rp2040.c): after "nina passthrough confirm"
		(nuttx/apps/nina) the board restarts into a mode that relays
		the USB CDC ACM port to the NINA-W102's UART (UART1 on GPIO8
		and GPIO9, the pins of SPI1's MISO and CS) with DTR and RTS on
		the module's GPIO0 and RESETN, for esptool.  The request is kept in the watchdog's scratch
		registers 0..3 over the restart; in the mode, rp2040_bringup()
		starts the USB device only and the init task runs the mode
		instead of nsh and the threads.  Closing the port at 300 bps,
		or RESET, restarts the normal firmware.  UART1 is driven here
		directly, so NuttX's own UART1 driver (RP2040_UART1) must be
		off: it would take the pins at boot.
