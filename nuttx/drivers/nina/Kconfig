#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config NANO_NINA
	bool "NINA-W102 SPI link (nina_request())"
	default y
	depends on RP2040_SPI1 && !RP2040_SPI_DMA
	---help---
		nina/nina_spi.c: nina_request() and nina_ip_config() of the
		Zephyr build's drivers/nina/nina_wifi.c (the WiFiNINA SPI
		protocol of the module's Arduino firmware), with the same
		framing, timeouts, error values and lazy initialization (the
		module is reset on the first request).  The board provides SPI1
		and the module's lines (src/nano_nina.c).  SPI1 is polled, as in
		the Zephyr build (CONFIG_SPI_PL022_INTERRUPT and _DMA off), so
		RP2040_SPI_DMA must be off.

if NANO_NINA

config NANO_NINA_SPI_FREQUENCY
	int "NINA SPI frequency in Hz"
	default 8000000
	range 1000000 10000000
	---help---
		The requested SPI clock.  The Zephyr build's
		CONFIG_NINA_SPI_FREQUENCY (default 8000000).  The PL022 divides
		clk_peri (125 MHz) by an even number: 8 MHz gives 7.8125 MHz in
		both builds.

config NANO_NINA_USRSOCK
	bool "NINA sockets (usrsock)"
	default y
	depends on NET_USRSOCK_CUSTOM
	---help---
		nina/nina_sock.c, nina_usrsock.c, nina_poller.c: the socket
		offload of the Zephyr build's drivers/nina/nina_socket.c as
		NuttX's usrsock (usrsock_request() in the kernel, handled in the
		calling thread), with the same socket table (10 sockets),
		commands, timeouts and errno names.  The thread "nina_event"
		polls the module's sockets and turns their state into usrsock
		events, as the Zephyr build's connect() and poll() poll in
		their callers.

config NANO_NINA_TCP_MAX_IO
	int "Maximum bytes per NINA TCP send"
	default 3584
	range 1 3584
	depends on NANO_NINA_USRSOCK
	---help---
		The Zephyr build's CONFIG_NINA_TCP_MAX_IO.  Bounds each TCP send
		to leave room for framing in the NINA SPI command buffer.  A RAW
		batch of up to 2448 bytes plus its MQTT header is sent in one
		command with the default.

endif # NANO_NINA
