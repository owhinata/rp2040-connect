#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config LSM6DSO_LOCAL
	bool "LSM6DSOX IMU driver (the shared LSM6DSO driver)"
	default y
	depends on I2C_DW_I2C0
	---help---
		common/drivers/lsm6dso: the driver's core (lsm6dso.c,
		lsm6dso_cal.c, lsm6dso_fifo.c) and the Zephyr build's binding
		(port/zephyr/lsm6dso_sensor.c: the device and the sensor
		API), with the device of port/nuttx/lsm6dso_instance.h, on
		ST's lsm6dso_reg.c (nuttx/stmemsc, fetched by
		script/setup.sh) and the port's small Zephyr compatibility
		layer (compat/: struct device, the sensor API, the I2C calls,
		the kernel calls of the core's boundary).  The board
		initializes the device in its bring-up, after I2C0 and before
		the key-value store, as the Zephyr build does before main()
		(src/rp2040_lsm6dso.c).  The FIFO stream (INT1, RTIO) is
		LSM6DSO_STREAM.  The Zephyr build's option of the same name
		(common/drivers/lsm6dso/port/zephyr/Kconfig), which replaces
		Zephyr's own driver (LSM6DSO there).

config LSM6DSO_STREAM
	bool
	default y
	depends on LSM6DSO_LOCAL
	---help---
		The FIFO stream of the LSM6DSO driver: the core's stream
		(lsm6dso_stream.c) and the Zephyr build's
		CONFIG_SENSOR_ASYNC_API part of its binding
		(port/zephyr/lsm6dso_rtio_stream.c, lsm6dso_rtio.c,
		lsm6dso_decoder.c, lsm6dso_os.c), on the compatibility
		layer's RTIO, work queues and gpio0 (compat/Make.defs).  Always on
		with LSM6DSO_LOCAL: as in Zephyr, lsm6dso_sensor.c does not
		build without it.  The board starts the layer's threads
		(zephyr_compat_initialize()) before the LSM6DSOX and builds
		common/compat/port/nuttx/rp2040_gpio_os.c for the INT1
		interrupt.
