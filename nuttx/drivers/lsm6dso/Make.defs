############################################################################
# nuttx/drivers/lsm6dso/Make.defs
#
# The LSM6DSOX driver, in common/drivers/lsm6dso, shared with the other
# builds: its core (lsm6dso.c: how the chip is operated; lsm6dso_cal.c:
# the conversion and the gyro bias at rest; lsm6dso_fifo.c: the FIFO
# words' parser; lsm6dso_stream.c: the FIFO stream; their headers in
# include/ and internal/, the boundaries lsm6dso_os.h and
# lsm6dso_stream_req.h in port/), and the Zephyr build's binding in
# port/zephyr (lsm6dso_sensor.c: the device and the sensor API; the
# stream's RTIO side lsm6dso_rtio_stream.c, lsm6dso_rtio.c and
# lsm6dso_decoder.c; the core's OS part lsm6dso_os_impl.h with
# lsm6dso_os.c, and its user part lsm6dso_stream_req_impl.h), compiled on
# the compatibility layer's kernel, device, GPIO, sensor, RTIO and I2C
# calls with the prelude of the shared sources (compat/common_prelude.h),
# as in the Zephyr build's module.  Its extended API
# <zephyr/drivers/sensor/lsm6dso.h> is include/lsm6dso.h, which
# common/compat finds.  This build's own file is
# port/nuttx/lsm6dso_instance.h (the device that lsm6dso_sensor.c defines
# at its end, from the board's values).  With them: ST's glue
# (stmemsc_i2c.c, stmemsc_mdelay.c and stmemsc.h, in
# common/drivers/stmemsc, shared with the FreeRTOS build and compiled
# without the prelude), and ST's register driver lsm6dso_reg.c, which
# script/setup.sh puts in nuttx/stmemsc (not in Git; built through
# st_lsm6dso_reg.c, which includes it).  Include paths: include/,
# internal/, port/, port/nuttx (before port/zephyr, so that this build's
# lsm6dso_instance.h is found) and port/zephyr.
# Included by nuttx/drivers/Makefile.  VPATH and DEPPATH of the driver's
# directories and of common/drivers/stmemsc are relative to nuttx/drivers
# (mkdeps needs relative ones); the objects are made there.
############################################################################

ifeq ($(CONFIG_NANO_LSM6DSO),y)
CSRCS += lsm6dso_sensor.c lsm6dso.c lsm6dso_cal.c lsm6dso_fifo.c
CSRCS += stmemsc_i2c.c stmemsc_mdelay.c
CSRCS += st_lsm6dso_reg.c
ifeq ($(CONFIG_NANO_LSM6DSO_STREAM),y)
CSRCS += lsm6dso_stream.c
CSRCS += lsm6dso_rtio_stream.c lsm6dso_rtio.c lsm6dso_os.c
CSRCS += lsm6dso_decoder.c
endif
DEPPATH += --dep-path lsm6dso
VPATH += :lsm6dso
DEPPATH += --dep-path ../../common/drivers/lsm6dso
VPATH += :../../common/drivers/lsm6dso
DEPPATH += --dep-path ../../common/drivers/lsm6dso/port/zephyr
VPATH += :../../common/drivers/lsm6dso/port/zephyr
DEPPATH += --dep-path ../../common/drivers/stmemsc
VPATH += :../../common/drivers/stmemsc
LSM6DSO_DIR = $(TOPDIR)$(DELIM)..$(DELIM)..$(DELIM)common$(DELIM)drivers$(DELIM)lsm6dso
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)..$(DELIM)stmemsc
CFLAGS += ${INCDIR_PREFIX}$(LSM6DSO_DIR)$(DELIM)include
CFLAGS += ${INCDIR_PREFIX}$(LSM6DSO_DIR)$(DELIM)internal
CFLAGS += ${INCDIR_PREFIX}$(LSM6DSO_DIR)$(DELIM)port
CFLAGS += ${INCDIR_PREFIX}$(LSM6DSO_DIR)$(DELIM)port$(DELIM)nuttx
CFLAGS += ${INCDIR_PREFIX}$(LSM6DSO_DIR)$(DELIM)port$(DELIM)zephyr
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)..$(DELIM)..$(DELIM)common$(DELIM)drivers$(DELIM)stmemsc
LSM6DSO_COMMON_CSRCS = $(notdir $(wildcard ../../common/drivers/lsm6dso/*.c \
                                           ../../common/drivers/lsm6dso/port/zephyr/*.c))
$(patsubst %.c,%$(OBJEXT),$(filter $(LSM6DSO_COMMON_CSRCS),$(CSRCS))): \
  CFLAGS += -include $(TOPDIR)$(DELIM)external$(DELIM)compat$(DELIM)common_prelude.h
endif
