############################################################################
# nuttx/drivers/compat/Make.defs
#
# The port's small Zephyr compatibility layer: the parts of Zephyr's device
# model, kernel (work queues, semaphores), RTIO, GPIO, sensor API and I2C
# API that the ported driver (lsm6dso/) and its callers use, under Zephyr's
# names.  Its OS-independent part is in common/compat (headers in
# common/compat/include, internal and port, include paths
# $(TOPDIR)/../../common/compat/<dir>); the NuttX implementation is
# common/compat/port/nuttx (the OS headers zephyr_os*.h, the OS parts
# *_os.h of the shared sources, the NuttX headers in zephyr/, the sources
# zephyr_*.c; include path $(TOPDIR)/../../common/compat/port/nuttx, which
# comes first).  Included by nuttx/drivers/Makefile.  VPATH and DEPPATH of
# common/compat and its port/nuttx are relative to nuttx/drivers (mkdeps
# needs relative ones); the objects are made there.  port/nuttx comes first
# in VPATH: common/compat/kernel_generic and net_offload have sources of
# the same names, and are not in it.  common_prelude.h of port/nuttx is
# the prelude of the sources shared with the Zephyr build and of the
# layer's shared sources (common/): the build definitions that compile
# them include it before each one (-include).
############################################################################

ifeq ($(CONFIG_LSM6DSO_LOCAL),y)
CSRCS += zephyr_device.c zephyr_i2c.c
DEPPATH += --dep-path ../../common/compat/port/nuttx
VPATH += :../../common/compat/port/nuttx
DEPPATH += --dep-path ../../common/compat
VPATH += :../../common/compat
endif

# The kernel objects, work queues, RTIO, gpio0 and the sensors' async API
# (default iodev and decoder) that the FIFO stream uses; zephyr_init.c
# (common/compat: the work queues' threads, the system work queue,
# zephyr_compat_initialize(), k_uptime_get()) is on zephyr_kernel.c's start
# of a thread.

ifeq ($(CONFIG_LSM6DSO_STREAM),y)
CSRCS += zephyr_kernel.c zephyr_init.c zephyr_mutex.c zephyr_work.c
CSRCS += zephyr_mem_blocks.c
CSRCS += zephyr_rtio.c
CSRCS += zephyr_rtio_workq.c zephyr_gpio.c zephyr_sensor_clock.c
CSRCS += sensor_default_rtio.c

# hwinfo_get_device_id() on the board's chip ID (the IMU service's
# session IDs).

CSRCS += zephyr_hwinfo.c
endif

# The network interface, net_mgmt requests and events, and the Wi-Fi
# requests that the applications use (wifi_profile.c, "wifi cred",
# time_sync.c, imu_raw_mqtt.c), which the NINA binding serves on the core
# (common/drivers/nina/port/nuttx/nina_wifi_mgmt.c), and the helpers of "wifi
# cred" (zephyr_wifi_utils.c).

ifeq ($(CONFIG_NINA_NET),y)
CSRCS += zephyr_net_if.c zephyr_net_mgmt.c zephyr_wifi_mgmt.c
CSRCS += zephyr_wifi_utils.c
endif

CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)..$(DELIM)..$(DELIM)common$(DELIM)compat$(DELIM)port$(DELIM)nuttx
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)..$(DELIM)..$(DELIM)common$(DELIM)compat$(DELIM)include
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)..$(DELIM)..$(DELIM)common$(DELIM)compat$(DELIM)port
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)..$(DELIM)..$(DELIM)common$(DELIM)compat$(DELIM)internal

# The sources of common/compat (not those of port/nuttx), with the prelude
# of the shared sources.

COMPAT_COMMON_CSRCS = $(notdir $(wildcard ../../common/compat/*.c))
$(patsubst %.c,%$(OBJEXT),$(filter $(COMPAT_COMMON_CSRCS),$(CSRCS))): \
  CFLAGS += -include $(TOPDIR)$(DELIM)..$(DELIM)..$(DELIM)common$(DELIM)compat$(DELIM)port$(DELIM)nuttx$(DELIM)common_prelude.h
