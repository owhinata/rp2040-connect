############################################################################
# nuttx/drivers/compat/Make.defs
#
# The port's small Zephyr compatibility layer: the parts of Zephyr's device
# model, kernel (work queues, semaphores), RTIO, GPIO, sensor API and I2C
# API that the ported driver (lsm6dso/) and its callers use, under Zephyr's names (headers in compat/zephyr/, include
# path $(TOPDIR)/external/compat).  Included by nuttx/drivers/Makefile.
############################################################################

ifeq ($(CONFIG_NANO_LSM6DSO),y)
CSRCS += zephyr_device.c zephyr_i2c.c
DEPPATH += --dep-path compat
VPATH += :compat
endif

# The kernel objects, work queues, RTIO, gpio0 and the sensors' async API
# (default iodev and decoder) that the FIFO stream uses.

ifeq ($(CONFIG_NANO_LSM6DSO_STREAM),y)
CSRCS += zephyr_kernel.c zephyr_work.c zephyr_mem_blocks.c zephyr_rtio.c
CSRCS += zephyr_rtio_workq.c zephyr_gpio.c zephyr_sensor_clock.c
CSRCS += sensor_default_rtio.c

# hwinfo_get_device_id() on the board's chip ID (the IMU service's
# session IDs).

CSRCS += zephyr_hwinfo.c
endif

CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)external$(DELIM)compat
