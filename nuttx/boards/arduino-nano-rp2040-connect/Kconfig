#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#
# Board-specific options of arduino-nano-rp2040-connect.  NuttX sources
# this file inside "if ARCH_BOARD_CUSTOM" through a copy,
# nuttx/nuttx/boards/dummy/Kconfig, made once at configure time;
# nuttx/script/build.sh configures again when this file changes.
#

config NANO_TICKLESS
	bool "System timer on the RP2040 TIMER (ALARM0)"
	default y
	depends on ARCH_CHIP_RP2040 && !SMP
	select ONESHOT
	select ONESHOT_COUNT
	select ALARM_ARCH
	---help---
		Drive the OS clock from ALARM0 of the RP2040 TIMER (64-bit, 1 MHz,
		from the crystal) through the oneshot/alarm interface
		(src/nano_oneshot.c, src/nano_timerisr.c and
		drivers/timers/arch_alarm.c) instead of the periodic SysTick of
		arch/arm/src/rp2040/rp2040_timerisr.c.  ALARM_ARCH selects
		ARCH_HAVE_TICKLESS, so SCHED_TICKLESS can be set (the imu
		defconfig sets it, with USEC_PER_TICK 100: the 100 us tickless
		kernel of the Zephyr build).  rp2040_timerisr.c is left out of the
		build by nuttx/patches/nuttx/0004 when ALARM_ARCH is set.
		ONESHOT_COUNT has no prompt and can only be selected.
		src/nano_oneshot.c also replaces the weak up_timer_gettick(),
		up_timer_gettime(), up_alarm_tick_start(), up_alarm_cancel(),
		up_udelay() and up_ndelay() of arch_alarm.c with versions that
		read the TIMER directly and convert with src/nano_timeconv.h
		(1 MHz counts, 100 us ticks, no 64-bit division), so it needs
		USEC_PER_TICK to be 100.  ONESHOT_FAST_DIVISION is not selected:
		it only changes the generic conversions, which these replace.

config NANO_STACK_SENTINEL
	bool "Stack sentinel (check the lowest stack word)"
	default y
	depends on STACK_COLORATION && !SMP && ARCH_ARMV6M
	select SCHED_INSTRUMENTATION
	select SCHED_INSTRUMENTATION_SWITCH
	select SCHED_INSTRUMENTATION_IRQHANDLER
	---help---
		Check that the lowest word of a task's stack still holds the
		coloration value when the task is switched out and at the end of
		every interrupt handler (for the interrupted task, whose stack
		the handler ran on), and halt (PANIC) if not: the counterpart of
		the Zephyr build's CONFIG_STACK_SENTINEL (src/nano_stackcheck.c).
		Implemented in the scheduler's instrumentation hooks
		sched_note_suspend() and sched_note_irqhandler(), which need
		SCHED_INSTRUMENTATION, SCHED_INSTRUMENTATION_SWITCH and
		SCHED_INSTRUMENTATION_IRQHANDLER but no note driver.
