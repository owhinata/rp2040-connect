#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#
# Board-specific options of arduino-nano-rp2040-connect.  NuttX sources
# this file inside "if ARCH_BOARD_CUSTOM" through a copy,
# nuttx/nuttx/boards/dummy/Kconfig, made once at configure time;
# nuttx/script/build.sh configures again when this file changes.
#

config NANO_TICKLESS
	bool "System timer on the RP2040 TIMER (ALARM0)"
	default y
	depends on ARCH_CHIP_RP2040 && !SMP
	select ONESHOT
	select ONESHOT_COUNT
	select ALARM_ARCH
	---help---
		Drive the OS clock from ALARM0 of the RP2040 TIMER (64-bit, 1 MHz,
		from the crystal) through the oneshot/alarm interface
		(src/nano_oneshot.c, src/nano_timerisr.c and
		drivers/timers/arch_alarm.c) instead of the periodic SysTick of
		arch/arm/src/rp2040/rp2040_timerisr.c.  ALARM_ARCH selects
		ARCH_HAVE_TICKLESS, so SCHED_TICKLESS can be set (the imu
		defconfig sets it, with USEC_PER_TICK 100: the 100 us tickless
		kernel of the Zephyr build).  rp2040_timerisr.c is left out of the
		build by nuttx/patches/nuttx/0004 when ALARM_ARCH is set.
		ONESHOT_COUNT has no prompt and can only be selected.
		src/nano_oneshot.c also replaces the weak up_timer_gettick(),
		up_timer_gettime(), up_alarm_tick_start(), up_alarm_cancel(),
		up_udelay() and up_ndelay() of arch_alarm.c with versions that
		read the TIMER directly and convert with src/nano_timeconv.h
		(1 MHz counts, 100 us ticks, no 64-bit division), so it needs
		USEC_PER_TICK to be 100.  ONESHOT_FAST_DIVISION is not selected:
		it only changes the generic conversions, which these replace.

config NANO_PERF
	bool "Perf counter on the RP2040 TIMER (up_perf_*)"
	default y
	depends on ARCH_CHIP_RP2040
	select ARCH_HAVE_PERF_EVENTS
	---help---
		src/nano_perf.c: up_perf_gettime() returns the TIMER count
		(nano_mono_us(), 1 MHz, 64 bits) and up_perf_getfreq() 1000000.
		The Cortex-M0+ has no cycle counter.  Used by the critical
		section monitor (SCHED_CRITMONITOR, SCHED_CPULOAD_CRITMONITOR) to
		account each task's CPU time at every context switch: the CPU
		column of ps, /proc/cpuload, /proc/<pid>/loadavg and the total
		run time in /proc/<pid>/critmon.  Without it,
		drivers/timers/arch_alarm.c supplies a slower counter in
		nanoseconds through the oneshot.

config NANO_STACK_SENTINEL
	bool "Stack sentinel (check the lowest stack word)"
	default y
	depends on STACK_COLORATION && !SMP && ARCH_ARMV6M
	select SCHED_INSTRUMENTATION
	select SCHED_INSTRUMENTATION_SWITCH
	select SCHED_INSTRUMENTATION_IRQHANDLER
	---help---
		Check that the lowest word of a task's stack still holds the
		coloration value when the task is switched out and at the end of
		every interrupt handler (for the interrupted task, whose stack
		holds the frame the hardware saved, and with ARCH_INTERRUPTSTACK=0
		the handler's own use too), and halt (PANIC) if not: the counterpart of
		the Zephyr build's CONFIG_STACK_SENTINEL (src/nano_stackcheck.c).
		Implemented in the scheduler's instrumentation hooks
		sched_note_suspend() and sched_note_irqhandler(), which need
		SCHED_INSTRUMENTATION, SCHED_INSTRUMENTATION_SWITCH and
		SCHED_INSTRUMENTATION_IRQHANDLER but no note driver.

config NANO_FLASH_KV
	bool "Key-value store in the last 8 KiB of the flash (/dev/config)"
	default y
	depends on ARCH_CHIP_RP2040 && !SMP
	depends on MTD_CONFIG_NVS && MTD_CONFIG_NAMED
	depends on MTD_CONFIG_BLOCKSIZE_MULTIPLE = 1
	---help---
		src/nano_flash_kv.c: an MTD over flash offsets 0xffe000-0xffffff
		(BOARD_KV_OFFSET, BOARD_KV_SIZE in include/board.h; __kv_start,
		__kv_end in scripts/nano-flash.ld), two 4 KiB erase sectors, the
		place of the Zephyr build's storage_partition, registered as
		/dev/config through NuttX's NVS (mtd_config_nvs.c).  Every erase
		and program is checked to lie inside that area.  The MTD reports
		a 1-byte program unit so that NVS packs its entries; it programs
		whole 256-byte pages with 0xff around the data.  At boot, an area
		that holds neither NuttX's NVS layout nor only erased bytes (for
		example the Zephyr build's NVS) is erased before it is mounted.
		The store's format is not the Zephyr build's.

config NANO_I2C0
	bool "I2C0 controller (LSM6DSOX, ATECC608A)"
	default y
	depends on ARCH_CHIP_RP2040 && I2C && !RP2040_I2C
	---help---
		src/nano_i2c.c: I2C0 on GPIO12 (SDA) and GPIO13 (SCL), a port of
		the controller path of the Zephyr build's DesignWare driver
		(zephyr/app/usb-console/drivers/i2c_dw/i2c_dw.c): interrupt
		driven, RX in batches of 4, 1 s transfer timeout with an abort,
		the Zephyr SCL counts (100 kHz, 400 kHz, 1 MHz).  It replaces
		NuttX's arch/arm/src/rp2040/rp2040_i2c.c, which must stay off
		(RP2040_I2C), and sets up the pins itself.  Registered as
		/dev/i2c0 when I2C_DRIVER is set (the i2c tool uses it).

config NANO_I2C0_DMA
	bool "DMA reads on I2C0"
	default y
	depends on NANO_I2C0 && !RP2040_DMAC
	---help---
		The Zephyr build's CONFIG_I2C_DW_RP2040_DMA (on there): a read
		of 32 to 3584 bytes that is the last message of a transfer (so
		it ends with STOP) runs on two DMA channels, one writing the
		command words to IC_DATA_CMD and one reading the data; other
		transfers, and reads when no DMA channel can be had, run on the
		interrupts.  The "i2c_dma" command (nuttx/apps/i2c_dma) switches
		it and shows its counters.  src/nano_dma.c drives the DMA as the
		Zephyr build's dma_rpi_pico.c does (channel 0 on DMA_IRQ_0, the
		others on DMA_IRQ_1, a channel request that never waits, a stop
		that does not wait), so NuttX's own DMA layer
		(arch/arm/src/rp2040/rp2040_dmac.c) must be off: RP2040_DMAC
		takes DMA_IRQ_0 for every channel.  Nothing else in this port
		uses the DMA.
