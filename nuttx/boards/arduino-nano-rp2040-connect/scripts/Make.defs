# Derived from boards/arm/rp2040/raspberrypi-pico/scripts/Make.defs
# (NuttX 13.1.0).  Only flash boot is supported.

include $(TOPDIR)/.config
include $(TOPDIR)/tools/Config.mk
include $(TOPDIR)/tools/rp2040/Config.mk
include $(TOPDIR)/arch/arm/src/armv6-m/Toolchain.defs

# Flash boot only (CONFIG_RP2040_FLASH_BOOT=y, checked by
# nuttx/script/build.sh); there is no SRAM-boot script.  The same script
# also links boot2 (arch/arm/src/rp2040/boot2/Make.defs).

LDSCRIPT = arduino-nano-rp2040-connect-flash.ld

ARCHSCRIPT += $(BOARD_DIR)$(DELIM)scripts$(DELIM)$(LDSCRIPT)

# boot2 (boot2_at25sf128a.S, CONFIG_RP2040_FLASH_CHIP): run the flash at
# clk_sys / 2 (62.5 MHz) instead of that file's default clk_sys / 4, as the
# Zephyr build and the Pico SDK boards do.  arch/arm/src/rp2040/boot2/Make.defs
# adds its own flags to these.

BOOT2CFLAGS += -DPICO_FLASH_SPI_CLKDIV=2

# Integer division on the SIO divider (CONFIG_RP2040_PICO_DIVIDER): every call
# to libgcc's division helpers goes to the Pico SDK's routines
# (divider_hardware.S, src/Make.defs), which define them as __wrap_<name>.
# nuttx/script/build.sh checks that libgcc's are not linked.

ifeq ($(CONFIG_RP2040_PICO_DIVIDER),y)
LDFLAGS += --wrap=__aeabi_idiv --wrap=__aeabi_idivmod
LDFLAGS += --wrap=__aeabi_uidiv --wrap=__aeabi_uidivmod
LDFLAGS += --wrap=__aeabi_ldivmod --wrap=__aeabi_uldivmod
endif

# The RP2040's code that no OS owns, shared with the Zephyr and FreeRTOS
# builds (common/chip/rp2040/include: rp2040_timer_us.h, the TIMER's read;
# rp2040_watchdog_reboot.h), for the board code, the drivers and the
# applications.

ARCHINCLUDES += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)..$(DELIM)..$(DELIM)common$(DELIM)chip$(DELIM)rp2040$(DELIM)include

CFLAGS := $(ARCHCFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
CXXFLAGS := $(ARCHCXXFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHXXINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
CPPFLAGS := $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
AFLAGS := $(CFLAGS) -D__ASSEMBLY__

NXFLATLDFLAGS1 = -r -d -warn-common
NXFLATLDFLAGS2 = $(NXFLATLDFLAGS1) -T$(TOPDIR)/binfmt/libnxflat/gnu-nxflat-pcrel.ld -no-check-sections
LDNXFLATFLAGS = -e main -s 2048
