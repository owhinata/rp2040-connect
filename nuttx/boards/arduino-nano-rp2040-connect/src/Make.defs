# Derived from boards/arm/rp2040/raspberrypi-pico/src/Make.defs
# (NuttX 13.1.0).  This file is read by boards/arm/rp2040/common/Makefile
# (in-tree) as board/Make.defs.  No LED or button code: the LED pin is
# shared with D13/SCK and the board has no buttons.

include $(TOPDIR)/Make.defs

CSRCS = nano_boardinitialize.c
CSRCS += nano_bringup.c
CSRCS += nano_chipid.c
CSRCS += nano_reset.c

ifeq ($(CONFIG_BOARD_USBDEV_SERIALSTR),y)
CSRCS += nano_usbserial.c
endif

# The tickless system timer (TIMER ALARM0) in place of the in-tree
# rp2040_timerisr.c, which patches/nuttx/0004 leaves out with ALARM_ARCH.

ifeq ($(CONFIG_NANO_TICKLESS),y)
CSRCS += nano_oneshot.c
CSRCS += nano_timerisr.c
endif

# The perf counter on the TIMER (up_perf_*), for the per-task CPU time of
# the critical section monitor (the CPU column of ps).

ifeq ($(CONFIG_NANO_PERF),y)
CSRCS += nano_perf.c
endif

# The idle loop with the CPU load measurement (cpu_load_get()) in place of
# the in-tree rp2040_idle.c, which patches/nuttx/0004 leaves out with
# ARCH_IDLE_CUSTOM.

ifeq ($(CONFIG_ARCH_IDLE_CUSTOM),y)
CSRCS += nano_idle.c
endif

# The key-value store's flash (the last 8 KiB) under /dev/config.

ifeq ($(CONFIG_NANO_FLASH_KV),y)
CSRCS += nano_flash_kv.c
endif

# SPI1 and the lines of the NINA-W102 (nuttx/drivers/nina uses them).

ifeq ($(CONFIG_NANO_NINA),y)
CSRCS += nano_nina.c
endif

# I2C0 (the LSM6DSOX and the ATECC608A), in place of the in-tree
# rp2040_i2c.c (RP2040_I2C off).

ifeq ($(CONFIG_NANO_I2C0),y)
CSRCS += nano_i2c.c
endif

# The i2c0 and lsm6dsox devices of the Zephyr compatibility layer
# (nuttx/drivers/compat, nuttx/drivers/lsm6dso).

ifeq ($(CONFIG_NANO_LSM6DSO),y)
CSRCS += nano_lsm6dso.c
endif

# GPIO bank 0 for the compatibility layer's gpio0 (the LSM6DSOX's INT1).

ifeq ($(CONFIG_NANO_LSM6DSO_STREAM),y)
CSRCS += nano_gpio.c
endif

# Its DMA reads: the DMA channels (in place of the in-tree rp2040_dmac.c,
# RP2040_DMAC off) and the command words (an unchanged copy of the Zephyr
# build's drivers/i2c_dw/i2c_dw_rp2040_commands.c).

ifeq ($(CONFIG_NANO_I2C0_DMA),y)
CSRCS += nano_dma.c
CSRCS += i2c_dw_rp2040_commands.c
endif

# The stack sentinel in the scheduler's switch hook.

ifeq ($(CONFIG_NANO_STACK_SENTINEL),y)
CSRCS += nano_stackcheck.c
endif

DEPPATH += --dep-path board
VPATH += :board
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)arch$(DELIM)$(CONFIG_ARCH)$(DELIM)src$(DELIM)board$(DELIM)board

# Headers shared with nuttx/drivers and the applications (app_log.h,
# log_ram.h, cpu_load.h, priorities.h, nano_nina.h, nano_i2c_dma.h):
# nuttx/drivers/include.

CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)external$(DELIM)include

# The small Zephyr compatibility layer (<zephyr/device.h>, ...):
# nuttx/drivers/compat.

CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)external$(DELIM)compat
