# Derived from boards/arm/rp2040/raspberrypi-pico/src/Make.defs
# (NuttX 13.1.0).  This file is read by boards/arm/rp2040/common/Makefile
# (in-tree) as board/Make.defs.  No LED or button code: the LED pin is
# shared with D13/SCK and the board has no buttons.

include $(TOPDIR)/Make.defs

CSRCS = nano_boardinitialize.c
CSRCS += nano_bringup.c
CSRCS += nano_chipid.c

# The restarts into BOOTSEL and through the watchdog (include/nano_reset.h).

CSRCS += nano_reset.c

ifeq ($(CONFIG_BOARD_USBDEV_SERIALSTR),y)
CSRCS += nano_usbserial.c
endif

# The tickless system timer (TIMER ALARM0) in place of the in-tree
# rp2040_timerisr.c, which patches/nuttx/0004 leaves out with ALARM_ARCH.

ifeq ($(CONFIG_NANO_TICKLESS),y)
CSRCS += nano_oneshot.c
CSRCS += nano_timerisr.c
endif

# The perf counter on the TIMER (up_perf_*), for the per-task CPU time of
# the critical section monitor (the CPU column of ps).

ifeq ($(CONFIG_NANO_PERF),y)
CSRCS += nano_perf.c
endif

# Integer division on the SIO divider: the Pico SDK's pico_divider
# (divider_hardware.S from nuttx/pico-sdk, PICO_SDK_PATH, which setup.sh
# sets), assembled with the SDK's headers and, for the two that the SDK's
# CMake build generates (pico/version.h, pico/config_autogen.h), the minimal
# ones of src/pico_sdk.  scripts/Make.defs wraps libgcc's helpers to its
# routines.

ifeq ($(CONFIG_NANO_HW_DIVIDER),y)
NANO_PICO_SDK_SRC = $(PICO_SDK_PATH)$(DELIM)src
NANO_PICO_SDK_INC = ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)arch$(DELIM)$(CONFIG_ARCH)$(DELIM)src$(DELIM)board$(DELIM)board$(DELIM)pico_sdk
NANO_PICO_SDK_INC += $(foreach d,rp2040$(DELIM)hardware_regs rp2040$(DELIM)pico_platform \
                       rp2_common$(DELIM)hardware_base rp2_common$(DELIM)hardware_divider \
                       rp2_common$(DELIM)pico_platform_common rp2_common$(DELIM)pico_platform_compiler \
                       rp2_common$(DELIM)pico_platform_sections rp2_common$(DELIM)pico_platform_panic \
                       common$(DELIM)pico_base_headers, \
                       ${INCDIR_PREFIX}$(NANO_PICO_SDK_SRC)$(DELIM)$(d)$(DELIM)include)
ASRCS += divider_hardware.S
DEPPATH += --dep-path $(NANO_PICO_SDK_SRC)$(DELIM)rp2_common$(DELIM)pico_divider
VPATH += :$(NANO_PICO_SDK_SRC)$(DELIM)rp2_common$(DELIM)pico_divider
divider_hardware$(OBJEXT): AFLAGS += $(NANO_PICO_SDK_INC)

# The dependencies of all the board's sources are made with CFLAGS.

.depend: CFLAGS += $(NANO_PICO_SDK_INC)
endif

# The idle loop with the CPU load measurement (cpu_load_get()) in place of
# the in-tree rp2040_idle.c, which patches/nuttx/0004 leaves out with
# ARCH_IDLE_CUSTOM.

ifeq ($(CONFIG_ARCH_IDLE_CUSTOM),y)
CSRCS += nano_idle.c
endif

# The key-value area's flash (the last 8 KiB): the OS boundary of
# common/compat/nano_flash_kv.h (nano_flash_kv.h is found through the -I
# of common/compat below).

ifeq ($(CONFIG_NANO_FLASH_KV),y)
CSRCS += nano_flash_kv.c
endif

# SPI1 and the lines of the NINA-W102 (nuttx/drivers/nina uses them).

ifeq ($(CONFIG_NINA),y)
CSRCS += nina_bus.c
endif

# I2C0 (the LSM6DSOX and the ATECC608A) and I2C1, in place of the in-tree
# rp2040_i2c.c (RP2040_I2C off).  Their OS-independent core is in
# common/drivers/i2c_dw (i2c_dw.c, one source for both instances); its
# NuttX part is here (i2c_dw_os_impl.h, i2c_dw_instance.h), found through
# the board's -I below.  VPATH and DEPPATH are relative to the directory
# where the board's objects are made, through the board symlink, as mkdeps
# needs.

ifneq ($(CONFIG_I2C_DW_I2C0)$(CONFIG_I2C_DW_I2C1),)
CSRCS += i2c_dw.c
DEPPATH += --dep-path board/../../../../common/drivers/i2c_dw
VPATH += :board/../../../../common/drivers/i2c_dw
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)..$(DELIM)..$(DELIM)common$(DELIM)drivers$(DELIM)i2c_dw
endif

# The i2c0 and lsm6dsox devices of the Zephyr compatibility layer
# (nuttx/drivers/compat, nuttx/drivers/lsm6dso).

ifeq ($(CONFIG_NANO_LSM6DSO),y)
CSRCS += nano_lsm6dso.c
endif

# GPIO bank 0 for the compatibility layer's gpio0 (the LSM6DSOX's INT1).

ifeq ($(CONFIG_NANO_LSM6DSO_STREAM),y)
CSRCS += nano_gpio.c
endif

# Its DMA reads: the two DMA channels on NuttX's own DMA driver
# (arch/arm/src/rp2040/rp2040_dmac.c, RP2040_DMAC), the boundary
# common/drivers/i2c_dw/i2c_dw_dma_os.h (found through the -I above).  The
# reads themselves and their command words are part of i2c_dw.c
# (i2c_dw_rp2040_dma_priv.h).

ifeq ($(CONFIG_I2C_DW_RP2040_DMA),y)
CSRCS += i2c_dw_dma_os.c
endif

# The NINA passthrough mode (include/nina_passthrough.h).  Its
# decisions, nina_passthrough_logic.h, are in common/drivers/nina (the -I
# below).

ifeq ($(CONFIG_NINA_PASSTHROUGH),y)
CSRCS += nina_passthrough.c
endif

# The stack sentinel in the scheduler's switch hook.

ifeq ($(CONFIG_NANO_STACK_SENTINEL),y)
CSRCS += nano_stackcheck.c
endif

DEPPATH += --dep-path board
VPATH += :board
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)arch$(DELIM)$(CONFIG_ARCH)$(DELIM)src$(DELIM)board$(DELIM)board

# Headers shared with nuttx/drivers and the applications: nuttx/drivers/include
# (nina_net.h, and the NuttX parts app_log_os.h and priorities_os.h),
# common/log (app_log.h, log_ram.h; common/compat has priorities.h,
# cpu_load.h, nano_cpuload.h and nano_gpio.h).  The NINA core's boundary to
# the board (nina_bus.h): common/drivers/nina.

CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)external$(DELIM)include
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)..$(DELIM)..$(DELIM)common$(DELIM)log
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)..$(DELIM)..$(DELIM)common$(DELIM)drivers$(DELIM)nina

# The small Zephyr compatibility layer (<zephyr/device.h>, ...): its NuttX
# implementation, nuttx/drivers/compat, then its OS-independent part,
# common/compat.

CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)external$(DELIM)compat
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)..$(DELIM)..$(DELIM)common$(DELIM)compat
