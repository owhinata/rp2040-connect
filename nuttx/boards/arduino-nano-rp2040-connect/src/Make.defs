# Derived from boards/arm/rp2040/raspberrypi-pico/src/Make.defs
# (NuttX 13.1.0).  This file is read by boards/arm/rp2040/common/Makefile
# (in-tree) as board/Make.defs.  No LED or button code: the LED pin is
# shared with D13/SCK and the board has no buttons.

include $(TOPDIR)/Make.defs

CSRCS = nano_boardinitialize.c
CSRCS += nano_bringup.c
CSRCS += nano_chipid.c
CSRCS += nano_reset.c

ifeq ($(CONFIG_BOARD_USBDEV_SERIALSTR),y)
CSRCS += nano_usbserial.c
endif

DEPPATH += --dep-path board
VPATH += :board
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)arch$(DELIM)$(CONFIG_ARCH)$(DELIM)src$(DELIM)board$(DELIM)board
