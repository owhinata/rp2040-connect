+/* The line end that ended the last line read by a task, until a byte other
+ * than CR or LF is read (see rl_lastnl()).
+ */
+
+struct rl_nlstate_s
+{
+  pid_t pid;
+  char  last;
+};
+
 /****************************************************************************
  * Private Data
  ****************************************************************************/
@@ -121,10 +137,54 @@ static FAR const struct extmatch_vtable_s *g_extmatch_vtbl = NULL;
 static struct cmdhist_s g_cmdhist;
 #endif /* CONFIG_READLINE_CMD_HISTORY */
 
+static struct rl_nlstate_s g_nlstate[RL_NLSTATE_SLOTS];
+static int g_nlnext;
+
 /****************************************************************************
  * Private Functions
  ****************************************************************************/
 
+/****************************************************************************
+ * Name: rl_lastnl
+ *
+ * Description:
+ *   Return the line end state of the calling task.  A line ends at CR or
+ *   at LF; the other one of a CR LF or LF CR pair is ignored, also when it
+ *   is read by the next readline() call.  So the state must outlive one
+ *   call, and it belongs to the input stream: each shell session (USB
+ *   console, Telnet) is its own task, so it is kept per task.  The last
+ *   RL_NLSTATE_SLOTS tasks are remembered.
+ *
+ ****************************************************************************/
+
+static FAR char *rl_lastnl(void)
+{
+  pid_t pid = getpid();
+  FAR char *last;
+  int i;
+
+  sched_lock();
+  for (i = 0; i < RL_NLSTATE_SLOTS; i++)
+    {
+      if (g_nlstate[i].pid == pid)
+        {
+          break;
+        }
+    }
+
+  if (i == RL_NLSTATE_SLOTS)
+    {
+      i = g_nlnext;
+      g_nlnext = (i + 1) % RL_NLSTATE_SLOTS;
+      g_nlstate[i].pid  = pid;
+      g_nlstate[i].last = '\0';
+    }
+
+  last = &g_nlstate[i].last;
+  sched_unlock();
+  return last;
+}
+
