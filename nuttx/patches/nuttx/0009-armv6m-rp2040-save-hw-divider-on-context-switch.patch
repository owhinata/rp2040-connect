diff --git a/arch/arm/src/rp2040/rp2040_divider.h b/arch/arm/src/rp2040/rp2040_divider.h
new file mode 100644
index 00000000..ccd5eedb
--- /dev/null
+++ b/arch/arm/src/rp2040/rp2040_divider.h
@@ -0,0 +1,120 @@
+/****************************************************************************
+ * arch/arm/src/rp2040/rp2040_divider.h
+ *
+ * SPDX-License-Identifier: MIT
+ *
+ * Save and restore the SIO hardware divider across context switches
+ * (CONFIG_RP2040_HW_DIVIDER).  Local to this workspace
+ * (nuttx/patches/nuttx/0009), not part of upstream NuttX.
+ *
+ ****************************************************************************/
+
+#ifndef __ARCH_ARM_SRC_RP2040_RP2040_DIVIDER_H
+#define __ARCH_ARM_SRC_RP2040_RP2040_DIVIDER_H
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdint.h>
+
+#include <nuttx/sched.h>
+
+#include "arm_internal.h"
+#include "hardware/rp2040_sio.h"
+
+#ifdef CONFIG_RP2040_HW_DIVIDER
+
+/****************************************************************************
+ * Inline Functions
+ ****************************************************************************/
+
+/* The division routines (the Pico SDK's pico_divider, linked in place of
+ * libgcc's) write the operands, wait 8 cycles and read REMAINDER, then
+ * QUOTIENT.  Writing an operand sets CSR.DIRTY and reading QUOTIENT clears
+ * it, so DIRTY is set exactly while a division has been started and its
+ * result not yet taken.  A routine that finds DIRTY set (it interrupted
+ * another one) saves the four registers, divides and puts them back, which
+ * is enough for interrupt handlers but not for a task switched out in the
+ * middle of a division: the next task's divisions would leave DIRTY clear
+ * and overwrite the registers.  So arm_doirq() saves the registers of the
+ * task that it switches away from in its TCB, and restores those of the
+ * task that it switches to, as the Pico SDK's FreeRTOS port does in its
+ * PendSV handler (portUSE_DIVIDER_SAVE_RESTORE), but only for a task that
+ * was in the middle of a division (DIRTY).
+ *
+ * The results are always ready when these run: more than 8 cycles have
+ * passed since the interrupted task's last operand write (the exception
+ * entry alone takes longer), and an interrupt handler that divided in the
+ * meantime either read the results or ended by writing QUOTIENT back,
+ * which also makes them ready.  Restoring writes the operands through
+ * UDIVIDEND and UDIVISOR and then the results, as the SDK's
+ * hw_divider_restore_state() does: writing a result stops the calculation
+ * that the operand writes started, and through the unsigned aliases the
+ * results read back exactly as saved (the signed aliases would negate them
+ * on read when the operands' signs differ).  A task that was preempted
+ * between writing its two operands, or in the SDK's own restore sequence,
+ * still gets the right result: it writes the remaining registers itself,
+ * and each operand write starts a new calculation of the kind (signed or
+ * unsigned) given by the register written.
+ */
+
+/****************************************************************************
+ * Name: rp2040_divider_save
+ *
+ * Description:
+ *   Save the divider into the TCB of the task that is being switched out,
+ *   if that task is in the middle of a division.
+ *
+ ****************************************************************************/
+
+static inline void rp2040_divider_save(struct tcb_s *tcb)
+{
+  struct xcptcontext *xcp = &tcb->xcp;
+
+  if ((getreg32(RP2040_SIO_DIV_CSR) & RP2040_SIO_DIV_CSR_DIRTY) != 0)
+    {
+      xcp->divider[0]    = getreg32(RP2040_SIO_DIV_UDIVIDEND);
+      xcp->divider[1]    = getreg32(RP2040_SIO_DIV_UDIVISOR);
+      xcp->divider[2]    = getreg32(RP2040_SIO_DIV_REMAINDER);
+      xcp->divider[3]    = getreg32(RP2040_SIO_DIV_QUOTIENT);
+      xcp->divider_dirty = 1;
+    }
+  else
+    {
+      xcp->divider_dirty = 0;
+    }
+}
+
+/****************************************************************************
+ * Name: rp2040_divider_restore
+ *
+ * Description:
+ *   Put back the divider of the task that is being switched in, or, if it
+ *   was not in the middle of a division (or never ran: up_initial_state()
+ *   clears the TCB's xcp), clear DIRTY so that its divisions do not save
+ *   and restore registers that nobody needs.
+ *
+ ****************************************************************************/
+
+static inline void rp2040_divider_restore(struct tcb_s *tcb)
+{
+  struct xcptcontext *xcp = &tcb->xcp;
+
+  if (xcp->divider_dirty != 0)
+    {
+      putreg32(xcp->divider[0], RP2040_SIO_DIV_UDIVIDEND);
+      putreg32(xcp->divider[1], RP2040_SIO_DIV_UDIVISOR);
+      putreg32(xcp->divider[2], RP2040_SIO_DIV_REMAINDER);
+      putreg32(xcp->divider[3], RP2040_SIO_DIV_QUOTIENT);
+    }
+  else
+    {
+      (void)getreg32(RP2040_SIO_DIV_QUOTIENT);
+    }
+}
+
+#endif /* CONFIG_RP2040_HW_DIVIDER */
+#endif /* __ARCH_ARM_SRC_RP2040_RP2040_DIVIDER_H */
