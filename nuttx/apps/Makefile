############################################################################
# nuttx/apps/Makefile
#
# Applications of the Nano RP2040 Connect port.  nuttx/nuttx-apps/external
# is a symlink to this directory.  Directory.mk generates ./Kconfig (a menu
# that sources */Kconfig of the subdirectories that have a Makefile) the
# first time the apps are configured; nuttx/script/build.sh deletes it and
# configures again when the set of applications changes.  Each application
# directory has a Makefile, a Make.defs and a Kconfig.
############################################################################

MENUDESC = "Nano RP2040 Connect apps"

include $(APPDIR)/Directory.mk
