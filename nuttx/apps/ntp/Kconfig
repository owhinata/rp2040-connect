#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config NANO_APP_NTP
	tristate "ntp command (ntp status)"
	default y
	depends on NANO_TIME_SYNC && NANO_SUBCMD
	---help---
		"ntp status": the Zephyr build's ntp command (cmd_ntp_status()
		of common/imu/time_sync.c, shared with the Zephyr build) with the
		same syntax and output.  The handler and its command set stay in
		that file, as in the Zephyr build (its SHELL_CMD_REGISTER()
		makes z_shell_main_ntp()); this is the builtin command that runs
		them.

if NANO_APP_NTP

config NANO_APP_NTP_PRIORITY
	int "ntp task priority"
	default 104
	---help---
		The shell's priority (NANO_PRIO_SHELL in
		common/compat/priorities.h): the Zephyr build runs shell
		commands in its shell thread.

config NANO_APP_NTP_STACKSIZE
	int "ntp stack size"
	default 3072
	---help---
		The Zephyr build runs the command on the shell thread's stack
		(CONFIG_SHELL_STACK_SIZE 3072).  Over Telnet the output goes to
		the NINA on this stack.

endif
