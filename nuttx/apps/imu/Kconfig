#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config NANO_KV_STORE
	bool "Key-value store (kv_store.c)"
	default y
	depends on MTD_CONFIG_NVS && MTD_CONFIG_NAMED
	---help---
		kv_store_init/set/get/delete() of the Zephyr build's
		src/kv_store.[ch] on /dev/config (NuttX's NVS on the board's
		key-value area, NANO_FLASH_KV), with the same keys (1-32
		characters: letters, digits, '_', '-', '.'), values (1-128 bytes)
		and error values.  Built into the application library; the "kv"
		command (NANO_APP_KV), the init task and the IMU service
		(NANO_APP_IMU) use it.

config NANO_APP_IMU
	tristate "IMU acquisition service and the imu command"
	default y
	depends on NANO_KV_STORE && NANO_SUBCMD && NANO_LSM6DSO_STREAM
	select LIBC_IPv4_ADDRCONV if !NET_IPv4
	---help---
		imu_stream.c: the Zephyr build's src/imu_stream.c with only the
		system calls replaced (on the Zephyr compatibility layer of
		nuttx/drivers/compat): the thread imu_stream_tid (Zephyr
		priority 9, NuttX 109, 2048-byte stack), which the init task
		starts at boot, and the "imu start|stop|status|cal" command
		with the Zephyr build's syntax and output.  The MQTT transport
		and the calibration are stubs for now (imu_raw_mqtt_null.c,
		imu_cal_null.c: no network, no calibration command); the time
		synchronization is NANO_TIME_SYNC (time_sync_null.c without
		it: no server time).  inet_pton() and inet_ntop() for imu.host
		need LIBC_IPv4_ADDRCONV while the network is off.

if NANO_APP_IMU

config NANO_APP_IMU_PRIORITY
	int "imu task priority"
	default 104
	---help---
		The shell's priority (NANO_PRIO_SHELL in
		nuttx/drivers/include/priorities.h): the Zephyr build runs shell
		commands in its shell thread.  The acquisition itself runs in
		imu_stream_tid (109).

config NANO_APP_IMU_STACKSIZE
	int "imu task stack size"
	default 3072
	---help---
		The Zephyr build runs the command on the shell thread's stack
		(CONFIG_SHELL_STACK_SIZE 3072).  "imu start" writes the session
		counter to the key-value store, with garbage collection, on
		this stack.

endif

config NANO_TIME_SYNC
	bool "Time synchronization with an NTP server (time_sync.c)"
	default y
	depends on NANO_APP_IMU && NANO_NINA_NET && NANO_NINA_DNS && NET_USRSOCK_UDP
	---help---
		time_sync.c: the Zephyr build's src/time_sync.c with only the
		system calls replaced: the thread time_sync_tid (Zephyr
		priority 9, NuttX 109, 2048-byte stack), which the init task
		starts at boot, asks the NTP server (the default gateway, or
		NANO_NINA_NTP_SERVER) every NANO_NINA_NTP_INTERVAL_MS while
		Wi-Fi is connected and keeps the estimate of its time
		(time_offset.c) that the IMU service puts on its batches
		(time_sync_unix_us()), and moves the realtime clock forward to
		it.  The "ntp status" command is NANO_APP_NTP.  Without this
		option time_sync_null.c stands in: no server time.

if NANO_TIME_SYNC

config NANO_NINA_NTP_SERVER
	string "NTP server hostname or IPv4 address"
	default ""
	---help---
		The Zephyr build's CONFIG_NINA_NTP_SERVER.  Empty uses the
		default gateway, normally the PC that provides the Wi-Fi
		network and runs an NTP server for the board.

config NANO_NINA_NTP_PORT
	int "NTP server UDP port"
	default 123
	range 1 65535
	---help---
		The Zephyr build's CONFIG_NINA_NTP_PORT.

config NANO_NINA_NTP_INTERVAL_MS
	int "Interval between NTP queries in milliseconds"
	default 2000
	range 250 3600000
	---help---
		The Zephyr build's CONFIG_NINA_NTP_INTERVAL_MS.  Queries go to a
		server on the local network.  Do not point short intervals at
		public servers.

endif
