############################################################################
# nuttx/apps/imu/Make.defs
#
# Read through nuttx/apps/Make.defs.  Adds this directory (the key-value
# store, and with CONFIG_NANO_APP_IMU the IMU service and the "imu" command)
# to the build when CONFIG_NANO_KV_STORE is set.
############################################################################

ifneq ($(CONFIG_NANO_KV_STORE),)
CONFIGURED_APPS += $(APPDIR)/external/imu
endif
