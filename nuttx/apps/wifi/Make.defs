############################################################################
# nuttx/apps/wifi/Make.defs
#
# Read through nuttx/apps/Make.defs.  Adds this directory (the stored Wi-Fi
# credentials, the Wi-Fi profile with its reconnection thread, and the
# "wifi" command) to the build when CONFIG_NANO_WIFI_CREDENTIALS is set.
############################################################################

ifneq ($(CONFIG_NANO_WIFI_CREDENTIALS),)
CONFIGURED_APPS += $(APPDIR)/external/wifi
endif
