############################################################################
# nuttx/apps/Make.defs
#
# Read by nuttx-apps/Make.defs (as external/Make.defs).  Pulls in the
# Make.defs of each application directory, which adds the directory to
# CONFIGURED_APPS when its Kconfig option is set: init/ (the init task,
# CONFIG_APP_INIT), bootsel/ (CONFIG_APP_BOOTSEL), dmesg/ (CONFIG_APP_DMESG),
# i2c_dma/ (CONFIG_I2C_DW_RP2040_DMA_SHELL), irqstack/ (CONFIG_APP_IRQSTACK),
# imu/ (the application's modules: the key-value store, CONFIG_KV_STORE, and
# the IMU service with the "imu" command, CONFIG_APP_IMU), kv/
# (CONFIG_APP_KV), nina/ (CONFIG_APP_NINA), ntp/ (CONFIG_APP_NTP), subcmd/
# (the subcommand dispatch shared by the commands: CONFIG_SUBCMD) and wifi/
# (the stored Wi-Fi credentials, CONFIG_WIFI_CREDENTIALS, the Wi-Fi profile,
# CONFIG_WIFI_PROFILE, and the "wifi" command, CONFIG_APP_WIFI).
############################################################################

include $(wildcard $(APPDIR)/external/*/Make.defs)
