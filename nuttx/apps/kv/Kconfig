#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config APP_KV
	tristate "kv command (key-value store)"
	default y
	depends on KV_STORE && SUBCMD
	---help---
		"kv set|sethex|get|delete|wipe": the Zephyr build's kv command
		(common/imu/kv_store.c, shared with the Zephyr build; its
		SHELL_CMD_REGISTER() makes z_shell_main_kv()) with the same
		syntax and messages, on the key-value store of nuttx/apps/imu
		(KV_STORE).  "kv wipe confirm" (not in the Zephyr build,
		common/compat/kv_store_os.h) erases the whole key-value area.

if APP_KV

config APP_KV_PRIORITY
	int "kv task priority"
	default 104
	---help---
		The shell's priority (NANO_PRIO_SHELL in
		common/compat/priorities.h): the Zephyr build runs shell
		commands in its shell thread.

config APP_KV_STACKSIZE
	int "kv stack size"
	default 3072
	---help---
		The Zephyr build runs the command on the shell thread's stack
		(CONFIG_SHELL_STACK_SIZE 3072).  The settings and NVS calls,
		with garbage collection, run on this stack too.

endif
