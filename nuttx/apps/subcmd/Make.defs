############################################################################
# nuttx/apps/subcmd/Make.defs
#
# Read through nuttx/apps/Make.defs.  Adds this directory (a library: no
# program of its own) to the build when CONFIG_NANO_SUBCMD is set.
############################################################################

ifneq ($(CONFIG_NANO_SUBCMD),)
CONFIGURED_APPS += $(APPDIR)/external/subcmd
endif
