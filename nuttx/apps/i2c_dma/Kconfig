#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config I2C_DW_RP2040_DMA_SHELL
	tristate "i2c_dma command (I2C0 DMA reads)"
	default y
	depends on I2C_DW_RP2040_DMA && NANO_SUBCMD
	---help---
		"i2c_dma mode [on|off]" and "i2c_dma stats": the command of the
		Zephyr and FreeRTOS builds
		(common/shell/i2c_dma_shell.c), with the same syntax,
		help and output, on the Zephyr shell's command handling of
		common/shell/zshell.c and the board's I2C driver
		(I2C_DW_RP2040_DMA).

if I2C_DW_RP2040_DMA_SHELL

config I2C_DW_RP2040_DMA_SHELL_PRIORITY
	int "i2c_dma task priority"
	default 104
	---help---
		The shell's priority (NANO_PRIO_SHELL in
		common/compat/priorities.h): the Zephyr build runs shell
		commands in its shell thread.

config I2C_DW_RP2040_DMA_SHELL_STACKSIZE
	int "i2c_dma stack size"
	default 3072
	---help---
		The Zephyr build runs the command on the shell thread's stack
		(CONFIG_SHELL_STACK_SIZE 3072).

endif
