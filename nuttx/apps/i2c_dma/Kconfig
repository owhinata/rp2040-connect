#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config NANO_APP_I2C_DMA
	tristate "i2c_dma command (I2C0 DMA reads)"
	default y
	depends on NANO_I2C0_DMA && NANO_SUBCMD
	---help---
		"i2c_dma mode [on|off]" and "i2c_dma stats": the Zephyr build's
		i2c_dma command (drivers/i2c_dw/i2c_dw.c) with the same syntax
		and output, on the board's I2C driver (NANO_I2C0_DMA).

if NANO_APP_I2C_DMA

config NANO_APP_I2C_DMA_PRIORITY
	int "i2c_dma task priority"
	default 104
	---help---
		The shell's priority (NANO_PRIO_SHELL in
		nuttx/drivers/include/priorities.h): the Zephyr build runs shell
		commands in its shell thread.

config NANO_APP_I2C_DMA_STACKSIZE
	int "i2c_dma stack size"
	default 3072
	---help---
		The Zephyr build runs the command on the shell thread's stack
		(CONFIG_SHELL_STACK_SIZE 3072).

endif
