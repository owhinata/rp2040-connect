#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config APP_NINA
	tristate "nina command (NINA-W102 module)"
	default y
	depends on NINA && SUBCMD
	---help---
		"nina version": the Zephyr build's nina command
		(src/main.c, cmd_nina_version()) with the same output, on
		nina_wifi_fw_version() of the NINA driver (NINA).  With the
		board's NINA_PASSTHROUGH, also "nina passthrough confirm"
		(the Zephyr and FreeRTOS builds'): a restart into the NINA
		passthrough mode for esptool.

if APP_NINA

config APP_NINA_PRIORITY
	int "nina task priority"
	default 104
	---help---
		The shell's priority (APP_PRIO_SHELL in
		common/compat/priorities.h): the Zephyr build runs shell
		commands in its shell thread, and nina_proto_request() runs the SPI
		transfer at the caller's priority.

config APP_NINA_STACKSIZE
	int "nina stack size"
	default 3072
	---help---
		The Zephyr build runs the command on the shell thread's stack
		(CONFIG_SHELL_STACK_SIZE 3072).

endif
