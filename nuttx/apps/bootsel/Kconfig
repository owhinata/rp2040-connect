#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config NANO_APP_BOOTSEL
	tristate "bootsel command (restart into the USB bootloader)"
	default y
	depends on ARCH_CHIP_RP2040
	---help---
		"bootsel" restarts the board into the boot ROM's USB loader
		(BOOTSEL: the RPI-RP2 drive), as the FreeRTOS build's command
		of the same name: the board's nano_reset_usb_boot()
		(<arch/board/nano_reset.h>, the ROM's reset_usb_boot(0, 0)), a
		flat build lets an application call it.  No confirmation word;
		arguments are ignored.

if NANO_APP_BOOTSEL

config NANO_APP_BOOTSEL_PRIORITY
	int "bootsel task priority"
	default 104
	---help---
		The shell's priority (NANO_PRIO_SHELL in
		common/compat/priorities.h).

config NANO_APP_BOOTSEL_STACKSIZE
	int "bootsel stack size"
	default 1024
	---help---
		One line of output and the restart.

endif
