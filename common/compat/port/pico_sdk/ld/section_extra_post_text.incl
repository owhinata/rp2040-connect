/* The Pico SDK's section_extra_post_text.incl (empty, included between the
 * end of text and the start of data, "to add extra sections into flash"),
 * replaced for the builds on the Pico SDK (common/compat/port/pico_sdk/compat.cmake,
 * pico_add_linker_script_override_path()): the iterable section of the
 * layer's socket implementations, as Zephyr's linker script makes it
 * (ITERABLE_SECTION_ROM(net_socket_register, ...)): the entries of
 * NET_SOCKET_REGISTER() and NET_SOCKET_OFFLOAD_REGISTER()
 * (<zephyr/net/socket.h>), kept and sorted by name, which is their priority
 * (zsock_socket() of subsys/net/lib/sockets/sockets.c takes the first that
 * accepts a socket).
 */
SECTIONS
{
    net_socket_register_area : ALIGN(4)
    {
        _net_socket_register_list_start = .;
        KEEP(*(SORT_BY_NAME(._net_socket_register.static.*)))
        _net_socket_register_list_end = .;
    } > FLASH
}
