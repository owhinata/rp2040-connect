/* The Pico SDK's section_extra_post_end.incl (empty, included after
 * section_end.incl for symbols and checks of the application), replaced
 * for the builds on the Pico SDK (common/pico_sdk/drivers/kv/kv.cmake): the bounds of the
 * key-value area, the last 8 KiB of the 16 MiB flash
 * (common/compat/flash_kv.h), and the checks that the image ends
 * before it.  flash_kv_os_initialize() (common/chip/rp2040/rp2040_flash_kv.c)
 * compares __kv_start and __kv_end with its constants at the start and
 * refuses every erase and program unless they agree.
 *
 *   __kv_start, __kv_end   XIP addresses of the area, [__kv_start, __kv_end)
 */
SECTIONS
{
    __kv_start = 0x10ffe000;
    __kv_end = 0x11000000;

    ASSERT(ORIGIN(FLASH) + LENGTH(FLASH) == __kv_start,
           "FLASH must end where the key-value area starts (pico_flash_region.ld)")
    ASSERT(__kv_end == ORIGIN(FLASH) + 0x1000000,
           "the key-value area must be the last 8 KiB of the 16 MiB flash")
    ASSERT(__flash_binary_end <= __kv_start,
           "the image reaches into the key-value area")
}
