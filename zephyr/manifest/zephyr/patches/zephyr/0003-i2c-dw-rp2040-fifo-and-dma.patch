+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/**
+ * @file
+ * @brief DMA reads of the RP2040's i2c0 in the DesignWare I2C driver
+ *
+ * The state of the DMA reads that an application's shell command reads and
+ * sets ("i2c_dma" of this workspace: common/shell/i2c_dma_shell.c).
+ * Zephyr's driver defines these functions with CONFIG_I2C_DW_RP2040_DMA
+ * (drivers/i2c/i2c_dw_rp2040_dma_priv.h; a local patch of this workspace,
+ * not meant for upstream: zephyr/manifest/zephyr/patches.yml). The
+ * workspace's other builds have the same declarations in their I2C0 core
+ * (common/drivers/i2c_dw/i2c_dw_rp2040_dma.h), which defines the same
+ * functions; common/tests/i2c_dw_sync.py checks that the declarations
+ * stay the same. No OS header.
+ */
+
+#ifndef ZEPHYR_INCLUDE_DRIVERS_I2C_I2C_DW_RP2040_DMA_H_
+#define ZEPHYR_INCLUDE_DRIVERS_I2C_I2C_DW_RP2040_DMA_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @brief Counters since boot, 32 bits, wrapping
+ */
+struct i2c_dw_rp2040_dma_stats {
+	/** Reads done by DMA */
+	uint32_t transfers;
+	/** Bytes of those reads */
+	uint32_t bytes;
+	/** DMA reads that failed (-EIO, -ETIMEDOUT), counted once each */
+	uint32_t errors;
+	/**
+	 * Reads that met the conditions but went to the interrupt path
+	 * because a DMA channel could not be had or configured
+	 */
+	uint32_t fallbacks;
+};
+
+/**
+ * @brief Get the counters of the DMA reads.
+ *
+ * @param stats The counters.
+ */
+void i2c_dw_rp2040_dma_get_stats(struct i2c_dw_rp2040_dma_stats *stats);
+
+/**
+ * @brief Whether the DMA reads are on (they are at boot).
+ */
+bool i2c_dw_rp2040_dma_enabled(void);
+
+/**
+ * @brief Turn the DMA reads on or off.
+ *
+ * Off sends every read to the interrupt path and drops the
+ * RX_FIFO_FULL_HLD_CTRL bit from IC_CON at the next transfer. Nothing waits
+ * for a transfer in progress: switch only while no transfer runs.
+ *
+ * @param enabled true for on.
+ */
+void i2c_dw_rp2040_dma_set_enabled(bool enabled);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ZEPHYR_INCLUDE_DRIVERS_I2C_I2C_DW_RP2040_DMA_H_ */
