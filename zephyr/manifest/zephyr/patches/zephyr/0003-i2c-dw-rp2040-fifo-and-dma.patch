Subject: [PATCH] drivers: i2c: dw: RP2040 FIFO depth and i2c0 DMA reads

Local patch of this workspace (zephyr/manifest/zephyr/patches.yml), not
meant for upstream.

The RP2040's controllers do not implement IC_COMP_PARAM_1, whose depths
read as 1; their FIFOs have 16 entries (i2c_dw_rp2040.h). On them,
i2c_dw_data_ask() masks the level-triggered TX_EMPTY while the RX FIFO has
no room and sets the RX threshold to a batch of 4 (or the bytes left), and
i2c_dw_isr() completes a read without STOP when its last bytes arrive and
drains the bytes left at STOP_DET. i2c_dw_runtime_configure() takes
bus_sem around i2c_dw_configure() and returns its result.

CONFIG_I2C_DW_RP2040_DMA (off by default) reads through the DMA
controller on i2c0 (i2c_dw_rp2040_dma.h): the last message of a transfer
when it is a read of 32 to 3584 bytes with a STOP and a 7-bit address.
i2c_dw_setup() then sets IC_CON.RX_FIFO_FULL_HLD_CTRL, i2c_dw_isr() only
reports the end and the errors of the DMA read, and a controller whose
channels or abort did not stop is refused from then on (quarantine).

The application provides the read commands (i2c_dw_rp2040_commands.h,
i2c_dw_rp2040_read_commands()) and the "i2c_dma" shell command, for which
the driver defines nano_i2c_dma_get_stats(), nano_i2c_dma_enabled() and
nano_i2c_dma_set_enabled() (nano_i2c_dma.h): the same functions as the
I2C0 driver of the workspace's other builds.

diff --git a/drivers/i2c/Kconfig.dw b/drivers/i2c/Kconfig.dw
index 4e1c923..987aa20 100644
--- a/drivers/i2c/Kconfig.dw
+++ b/drivers/i2c/Kconfig.dw
@@ -30,6 +30,20 @@ config I2C_DW_LPSS_DMA
 	  data transfers. All Tx operations are done using dma channel 0 and
 	  all Rx operations are done using dma channel 1.
 
+config I2C_DW_RP2040_DMA
+	bool "RP2040 I2C0 DMA reads"
+	depends on SOC_RP2040 && DMA_RPI_PICO && !SMP
+	depends on !I2C_DW_LPSS_DMA
+	help
+	  Read through two channels of the RP2040's DMA controller on i2c0:
+	  a read of 32 to 3584 bytes that is the last message of a transfer,
+	  with a STOP and a 7-bit address. Other messages, and reads when no
+	  channel is free, take the interrupt path. The application provides
+	  i2c_dw_rp2040_commands.h and i2c_dw_rp2040_read_commands(), which
+	  build the read commands, and nano_i2c_dma.h, whose functions the
+	  driver defines for the application's "i2c_dma" shell command. A
+	  local patch of this workspace, not meant for upstream.
+
 config I2C_DW_EXTENDED_SUPPORT
 	bool "Extended DW features"
 	help
diff --git a/drivers/i2c/i2c_dw.c b/drivers/i2c/i2c_dw.c
index 1dff501..8fe5669 100644
--- a/drivers/i2c/i2c_dw.c
+++ b/drivers/i2c/i2c_dw.c
@@ -34,6 +34,15 @@
 #include <zephyr/sys/util.h>
 #include <zephyr/sys/minmax.h>
 
+#ifdef CONFIG_I2C_DW_RP2040_DMA
+#include <zephyr/drivers/dma.h>
+#include <zephyr/dt-bindings/dma/rpi-pico-dma-rp2040.h>
+#include <hardware/dma.h>
+#include <hardware/regs/i2c.h>
+#include "i2c_dw_rp2040_commands.h"
+#include "nano_i2c_dma.h"
+#endif
+
 #if defined(CONFIG_I2C_DW_LPSS_DMA)
 #include <zephyr/drivers/dma.h>
 #include <zephyr/drivers/dma/dma_intel_lpss.h>
@@ -51,6 +60,8 @@ LOG_MODULE_REGISTER(i2c_dw);
 
 #include "i2c-priv.h"
 
+#include "i2c_dw_rp2040.h"
+
 /*
  * @param dev: DW I2C device instance
  * @param wrapper_dev: Callers device instance
@@ -359,15 +370,20 @@ static inline void i2c_dw_data_ask(const struct device *dev)
 	ic_comp_param_1.raw = read_comp_param_1(reg_base);
 	rx_buffer_depth = ic_comp_param_1.bits.rx_buffer_depth + 1;
 	tx_buffer_depth = ic_comp_param_1.bits.tx_buffer_depth + 1;
+	if (i2c_dw_rp2040_controller(dev)) {
+		rx_buffer_depth = RP2040_I2C_FIFO_DEPTH;
+		tx_buffer_depth = RP2040_I2C_FIFO_DEPTH;
+	}
 
 	/* How many bytes we can actually ask */
 	rx_empty = (rx_buffer_depth - read_rxflr(reg_base)) - dw->rx_pending;
 
 	if (rx_empty < 0) {
-		/* RX FIFO expected to be full.
-		 * So don't request any bytes, yet.
-		 */
-		return;
+		if (!i2c_dw_rp2040_controller(dev)) {
+			return;
+		}
+		/* Continue to the RX wait path so TX_EMPTY can be masked. */
+		rx_empty = 0;
 	}
 
 	/* How many empty slots in TX FIFO (as command queue) */
@@ -377,6 +393,20 @@ static inline void i2c_dw_data_ask(const struct device *dev)
 	cnt = MIN(rx_buffer_depth, dw->request_bytes);
 	cnt = min3(tx_empty, rx_empty, cnt);
 
+	/* TX_EMPTY is level-triggered. When the RX FIFO has no safe space,
+	 * mask it until pending reads make enough progress for RX_FULL.
+	 */
+	if (i2c_dw_rp2040_controller(dev) && cnt == 0 && dw->rx_pending > 0U) {
+		uint32_t threshold = MIN(RP2040_I2C_RX_BATCH,
+					 MIN(dw->xfr_len, dw->rx_pending));
+
+		if (threshold > 0U) {
+			write_rx_tl(threshold - 1U, reg_base);
+			clear_bit_intr_mask_tx_empty(reg_base);
+			return;
+		}
+	}
+
 	while (cnt > 0) {
 		/* Tell controller to get another byte */
 		data = IC_DATA_CMD_CMD;
@@ -436,6 +466,13 @@ static void i2c_dw_data_read(const struct device *dev)
 		}
 	}
 #endif
+	/* Lower the threshold for the last short portion of a read. */
+	if (i2c_dw_rp2040_controller(dev) && dw->xfr_len > 0U) {
+		write_rx_tl(MIN(RP2040_I2C_RX_BATCH, dw->xfr_len) - 1U, reg_base);
+		if (dw->request_bytes > 0U) {
+			set_bit_intr_mask_tx_empty(reg_base);
+		}
+	}
 	/* Nothing to receive anymore */
 	if (dw->xfr_len == 0U) {
 		dw->state &= ~I2C_DW_CMD_RECV;
@@ -520,6 +557,10 @@ static void i2c_dw_target_read_clear_intr_bits(const struct device *dev,
 					       union ic_interrupt_register intr_stat);
 #endif
 
+#ifdef CONFIG_I2C_DW_RP2040_DMA
+#include "i2c_dw_rp2040_dma.h"
+#endif
+
 static void i2c_dw_isr(const struct device *port)
 {
 	struct i2c_dw_dev_config *const dw = port->data;
@@ -532,6 +573,28 @@ static void i2c_dw_isr(const struct device *port)
 	 * so there is no need to read the register multiple times.
 	 */
 	intr_stat.raw = read_intr_stat(reg_base);
+#ifdef CONFIG_I2C_DW_RP2040_DMA
+	if (atomic_get(&dw->rp_dma_active)) {
+		atomic_val_t events = 0;
+		if (intr_stat.raw &
+		    (DW_INTR_STAT_TX_ABRT | DW_INTR_STAT_TX_OVER | DW_INTR_STAT_RX_OVER |
+		     DW_INTR_STAT_RX_UNDER | DW_INTR_STAT_SCL_STUCK_LOW)) {
+			dw->state |= I2C_DW_CMD_ERROR;
+			(void)i2c_dw_error_chk(port);
+			events |= RP_DMA_ERROR;
+		}
+		if (intr_stat.raw & DW_INTR_STAT_STOP_DET) {
+#if CONFIG_I2C_ALLOW_NO_STOP_TRANSACTIONS
+			dw->need_setup = true;
+#endif
+			events |= RP_DMA_STOP;
+		}
+		write_intr_mask(0, reg_base);
+		(void)read_clr_intr(reg_base);
+		i2c_dw_rp_dma_notify(dw, events);
+		return;
+	}
+#endif
 
 	/*
 	 * Causes of an interrupt:
@@ -576,6 +639,13 @@ static void i2c_dw_isr(const struct device *port)
 		/* Check if the RX FIFO reached threshold */
 		if (intr_stat.bits.rx_full) {
 			i2c_dw_data_read(port);
+			/* TX_EMPTY may be masked while waiting for the last RX batch.
+			 * A no-STOP message must still complete when its data arrives.
+			 */
+			if (i2c_dw_rp2040_controller(port) && dw->xfr_len == 0U &&
+			    !(dw->xfr_flags & I2C_MSG_STOP)) {
+				goto done;
+			}
 		}
 
 #ifdef CONFIG_I2C_TARGET
@@ -606,6 +676,12 @@ static void i2c_dw_isr(const struct device *port)
 
 		/* STOP detected: finish processing this message */
 		if (intr_stat.bits.stop_det) {
+			/* Drain any final bytes even if the RX threshold was not met. */
+			if (i2c_dw_rp2040_controller(port) &&
+			    (dw->xfr_flags & I2C_MSG_RW_MASK) == I2C_MSG_READ &&
+			    dw->xfr_len > 0U) {
+				i2c_dw_data_read(port);
+			}
 			value = read_clr_stop_det(reg_base);
 #if CONFIG_I2C_ALLOW_NO_STOP_TRANSACTIONS
 			dw->need_setup = true;
@@ -726,6 +802,11 @@ static int i2c_dw_setup(const struct device *dev, uint16_t target_address)
 	}
 
 	ic_con.bits.restart_en = 1U;
+#ifdef CONFIG_I2C_DW_RP2040_DMA
+	if (dev == DEVICE_DT_GET(DT_NODELABEL(i2c0)) && atomic_get(&rp_dma_enabled)) {
+		ic_con.raw |= I2C_IC_CON_RX_FIFO_FULL_HLD_CTRL_BITS;
+	}
+#endif
 
 	/* Set addressing mode - (initialization = 7 bit) */
 	if (I2C_MSG_ADDR_10_BITS & dw->app_config) {
@@ -867,6 +948,13 @@ static int i2c_dw_transfer(const struct device *dev, struct i2c_msg *msgs, uint8
 		return ret;
 	}
 
+#ifdef CONFIG_I2C_DW_RP2040_DMA
+	if (dw->rp_dma_quarantined) {
+		ret = -EIO;
+		goto error;
+	}
+#endif
+
 	/* check if the state is sda/scl stuck at low state */
 	if (dw->state & I2C_DW_STUCK_ERR_MASK) {
 		/* try to recovery */
@@ -953,6 +1041,26 @@ static int i2c_dw_transfer(const struct device *dev, struct i2c_msg *msgs, uint8
 			dw->request_bytes = dw->xfr_len;
 		}
 
+		/* Short reads must not wait for a full RX batch. */
+		if (i2c_dw_rp2040_controller(dev) && test_bit_con_master_mode(reg_base) &&
+		    (dw->xfr_flags & I2C_MSG_RW_MASK) == I2C_MSG_READ && dw->xfr_len > 0U) {
+			write_rx_tl(MIN(RP2040_I2C_RX_BATCH, dw->xfr_len) - 1U, reg_base);
+		}
+
+#ifdef CONFIG_I2C_DW_RP2040_DMA
+		if (msg_left == 1 && (dw->xfr_flags & I2C_MSG_RW_MASK) == I2C_MSG_READ) {
+			ret = i2c_dw_rp_dma_read(dev, cur_msg);
+			if (ret != -EAGAIN) {
+				if (ret) {
+					break;
+				}
+				cur_msg++;
+				msg_left--;
+				continue;
+			}
+		}
+#endif
+
 		/* Enable interrupts to trigger ISR */
 		if (test_bit_con_master_mode(reg_base)) {
 			/* Enable necessary interrupts */
@@ -1115,11 +1223,18 @@ static int i2c_dw_runtime_configure(const struct device *dev, uint32_t config)
 		return ret;
 	}
 
-	ret = i2c_dw_configure(dev, config);
+	struct i2c_dw_dev_config *const dw = dev->data;
 
+	k_sem_take(&dw->bus_sem, K_FOREVER);
+#ifdef CONFIG_I2C_DW_RP2040_DMA
+	ret = dw->rp_dma_quarantined ? -EIO : i2c_dw_configure(dev, config);
+#else
+	ret = i2c_dw_configure(dev, config);
+#endif
+	k_sem_give(&dw->bus_sem);
 	pm_device_runtime_put(dev);
 
-	return 0;
+	return ret;
 }
 
 #ifdef CONFIG_I2C_TARGET
@@ -1533,6 +1648,9 @@ static int i2c_dw_initialize(const struct device *dev)
 
 	k_sem_init(&dw->device_sync_sem, 0, K_SEM_MAX_LIMIT);
 	k_sem_init(&dw->bus_sem, 1, 1);
+#ifdef CONFIG_I2C_DW_RP2040_DMA
+	k_sem_init(&dw->rp_dma_sem, 0, K_SEM_MAX_LIMIT);
+#endif
 
 	LOG_DBG("initialize done");
 
