diff --git a/drivers/i2c/i2c_dw_rp2040.h b/drivers/i2c/i2c_dw_rp2040.h
new file mode 100644
index 0000000..f90f193
--- /dev/null
+++ b/drivers/i2c/i2c_dw_rp2040.h
@@ -0,0 +1,40 @@
+/*
+ * Copyright (c) 2026 rp2040-connect contributors
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/*
+ * The RP2040's two I2C controllers in the DesignWare driver: the depth of
+ * their FIFOs, which IC_COMP_PARAM_1 does not give, the RX batch that
+ * i2c_dw_data_ask(), i2c_dw_data_read(), i2c_dw_isr() and i2c_dw_transfer()
+ * use for the RX threshold, and the check that a device is one of them.
+ *
+ * Included once, by i2c_dw.c (a local patch of this workspace, not meant for
+ * upstream: zephyr/manifest/zephyr/patches.yml).
+ */
+
+#ifndef ZEPHYR_DRIVERS_I2C_I2C_DW_RP2040_H_
+#define ZEPHYR_DRIVERS_I2C_I2C_DW_RP2040_H_
+
+/* RP2040 does not implement IC_COMP_PARAM_1; its encoded depths read as zero
+ * even though its RX and TX FIFOs each contain 16 entries. Limit this
+ * workaround to the RP2040 I2C controllers.
+ */
+#define RP2040_I2C_FIFO_DEPTH 16U
+#define RP2040_I2C_RX_BATCH 4U
+
+static bool i2c_dw_rp2040_controller(const struct device *dev)
+{
+#ifdef CONFIG_SOC_RP2040
+	mm_reg_t base = DEVICE_MMIO_GET(dev);
+
+	return base == DT_REG_ADDR(DT_NODELABEL(i2c0)) ||
+	       base == DT_REG_ADDR(DT_NODELABEL(i2c1));
+#else
+	ARG_UNUSED(dev);
+	return false;
+#endif
+}
+
+#endif /* ZEPHYR_DRIVERS_I2C_I2C_DW_RP2040_H_ */
diff --git a/drivers/i2c/i2c_dw_rp2040_dma_priv.h b/drivers/i2c/i2c_dw_rp2040_dma_priv.h
new file mode 100644
index 0000000..c30ca23
--- /dev/null
+++ b/drivers/i2c/i2c_dw_rp2040_dma_priv.h
@@ -0,0 +1,293 @@
+/*
+ * Copyright (c) 2026 rp2040-connect contributors
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/*
+ * CONFIG_I2C_DW_RP2040_DMA: reads of the RP2040's i2c0 through two channels
+ * of its DMA controller (Zephyr's dma_rpi_pico.c), one writing the read
+ * commands to IC_DATA_CMD, the other taking the bytes from it.
+ *
+ * i2c_dw_rp2040_dma_read() takes the last message of a transfer when it is a
+ * read of 32 to I2C_DW_RP2040_DMA_MAX_READ bytes with a STOP and a 7-bit
+ * address, and returns -EAGAIN for any other, or when no channel can be
+ * had, which sends the message to the interrupt path. The command words
+ * come from i2c_dw_rp2040_read_commands().
+ *
+ * Only i2c0 reads through DMA, one read at a time under its bus_sem: the
+ * command words, the bytes read, the semaphore and events of the read in
+ * progress and its two channels are this file's static variables, not
+ * members of struct i2c_dw_dev_config. The members rp2040_dma_active and
+ * rp2040_dma_quarantined stay there, as i2c_dw_isr(), i2c_dw_transfer() and
+ * i2c_dw_runtime_configure() read them for every instance.
+ *
+ * i2c_dw_rp2040_dma_get_stats(), i2c_dw_rp2040_dma_enabled() and
+ * i2c_dw_rp2040_dma_set_enabled()
+ * (<zephyr/drivers/i2c/i2c_dw_rp2040_dma.h>) give the counters and switch
+ * the DMA reads, for an application's shell command.
+ *
+ * Included once, by i2c_dw.c, after its declarations and its log module:
+ * these are i2c_dw.c's own static functions and variables, on its register
+ * accessors, and i2c_dw_isr(), i2c_dw_setup() and i2c_dw_transfer() use
+ * them. A local patch of this workspace, not meant for upstream
+ * (zephyr/manifest/zephyr/patches.yml).
+ */
+
+#ifndef ZEPHYR_DRIVERS_I2C_I2C_DW_RP2040_DMA_PRIV_H_
+#define ZEPHYR_DRIVERS_I2C_I2C_DW_RP2040_DMA_PRIV_H_
+
+#include <zephyr/drivers/dma.h>
+#include <zephyr/drivers/i2c/i2c_dw_rp2040_dma.h>
+#include <zephyr/dt-bindings/dma/rpi-pico-dma-rp2040.h>
+#include <hardware/dma.h>
+#include <hardware/regs/i2c.h>
+
+#define I2C_DW_RP2040_DMA_MAX_READ (512U * 7U)
+
+#define RP2040_DMA_TX_DONE BIT(0)
+#define RP2040_DMA_RX_DONE BIT(1)
+#define RP2040_DMA_STOP    BIT(2)
+#define RP2040_DMA_ERROR   BIT(3)
+#define RP2040_DMA_DONE    (RP2040_DMA_TX_DONE | RP2040_DMA_RX_DONE | RP2040_DMA_STOP)
+
+static atomic_t rp2040_dma_transfers, rp2040_dma_bytes, rp2040_dma_errors, rp2040_dma_fallbacks;
+static atomic_t rp2040_dma_enabled = ATOMIC_INIT(1);
+
+/* The read in progress on i2c0 (i2c_dw_rp2040_dma_read()). */
+static K_SEM_DEFINE(rp2040_dma_sem, 0, K_SEM_MAX_LIMIT);
+static atomic_t rp2040_dma_events;
+static int rp2040_dma_tx_channel;
+static int rp2040_dma_rx_channel;
+static uint16_t rp2040_dma_commands[I2C_DW_RP2040_DMA_MAX_READ];
+static uint8_t rp2040_dma_buffer[I2C_DW_RP2040_DMA_MAX_READ];
+
+/* The IC_DATA_CMD words of a read (one read command per byte, RESTART on the
+ * first when asked, STOP on the last). The I2C0 core of the workspace's other
+ * builds has the same function in common/drivers/i2c_dw/i2c_dw_rp2040_dma_priv.h;
+ * common/tests/i2c_dw_sync.py checks that the two stay the same.
+ */
+#define RP2040_I2C_CMD_READ    (1U << 8)
+#define RP2040_I2C_CMD_STOP    (1U << 9)
+#define RP2040_I2C_CMD_RESTART (1U << 10)
+static int i2c_dw_rp2040_read_commands(uint16_t *commands, size_t capacity, size_t length,
+				       bool restart)
+{
+	if (!commands || !length || length > capacity) {
+		return -EINVAL;
+	}
+	for (size_t i = 0; i < length; i++) {
+		commands[i] = RP2040_I2C_CMD_READ;
+	}
+	if (restart) {
+		commands[0] |= RP2040_I2C_CMD_RESTART;
+	}
+	commands[length - 1] |= RP2040_I2C_CMD_STOP;
+	return 0;
+}
+
+static void i2c_dw_rp2040_dma_notify(atomic_val_t events)
+{
+	atomic_val_t all = atomic_or(&rp2040_dma_events, events) | events;
+	if ((all & RP2040_DMA_ERROR) || (all & RP2040_DMA_DONE) == RP2040_DMA_DONE) {
+		k_sem_give(&rp2040_dma_sem);
+	}
+}
+
+static void i2c_dw_rp2040_dma_callback(const struct device *dma, void *user_data, uint32_t channel,
+				       int status)
+{
+	struct i2c_dw_dev_config *dw = user_data;
+	ARG_UNUSED(dma);
+	if (!atomic_get(&dw->rp2040_dma_active)) {
+		return;
+	}
+	i2c_dw_rp2040_dma_notify(status < 0 ? RP2040_DMA_ERROR
+					    : (channel == rp2040_dma_tx_channel
+						       ? RP2040_DMA_TX_DONE
+						       : RP2040_DMA_RX_DONE));
+}
+
+/* A stop only requests an abort in Zephyr's RP2040 DMA driver.  Wait for BUSY,
+ * then acknowledge late completions (RP2040-E13) before releasing channels.
+ */
+static bool i2c_dw_rp2040_dma_stop(const struct device *dma, int tx, int rx)
+{
+	int64_t deadline = k_uptime_get() + 100;
+	(void)dma_stop(dma, tx);
+	(void)dma_stop(dma, rx);
+	while (dma_channel_is_busy(tx) || dma_channel_is_busy(rx) || dma_hw->abort) {
+		if (k_uptime_get() >= deadline) {
+			return false;
+		}
+		k_sleep(K_MSEC(1));
+	}
+	dma_irqn_acknowledge_channel(0, tx);
+	dma_irqn_acknowledge_channel(1, tx);
+	dma_irqn_acknowledge_channel(0, rx);
+	dma_irqn_acknowledge_channel(1, rx);
+	return true;
+}
+
+static int i2c_dw_rp2040_dma_read(const struct device *dev, struct i2c_msg *msg)
+{
+	const struct device *dma = DEVICE_DT_GET(DT_NODELABEL(dma));
+	const struct i2c_dw_rom_config *rom = dev->config;
+	struct i2c_dw_dev_config *dw = dev->data;
+	mm_reg_t base = DEVICE_MMIO_GET(dev);
+	struct dma_block_config tx_block = {0}, rx_block = {0};
+	struct dma_config tx_cfg = {0}, rx_cfg = {0};
+	int tx, rx, ret;
+	bool started = false;
+
+	if (!atomic_get(&rp2040_dma_enabled) || dev != DEVICE_DT_GET(DT_NODELABEL(i2c0)) ||
+	    !device_is_ready(dma) || msg->len < 32 || msg->len > I2C_DW_RP2040_DMA_MAX_READ ||
+	    !(msg->flags & I2C_MSG_STOP) || (msg->flags & I2C_MSG_ADDR_10_BITS) ||
+	    (dw->app_config & I2C_ADDR_10_BITS)) {
+		return -EAGAIN;
+	}
+	tx = dma_request_channel(dma, NULL);
+	if (tx < 0) {
+		atomic_inc(&rp2040_dma_fallbacks);
+		return -EAGAIN;
+	}
+	rx = dma_request_channel(dma, NULL);
+	if (rx < 0) {
+		atomic_inc(&rp2040_dma_fallbacks);
+		dma_release_channel(dma, tx);
+		return -EAGAIN;
+	}
+	rp2040_dma_tx_channel = tx;
+	rp2040_dma_rx_channel = rx;
+	i2c_dw_rp2040_read_commands(rp2040_dma_commands, ARRAY_SIZE(rp2040_dma_commands), msg->len,
+				    dw->xfr_flags & I2C_MSG_RESTART);
+	tx_block.source_address = (uintptr_t)rp2040_dma_commands;
+	tx_block.dest_address = base + DW_IC_REG_DATA_CMD;
+	tx_block.block_size = msg->len * sizeof(uint16_t);
+	tx_block.source_addr_adj = DMA_ADDR_ADJ_INCREMENT;
+	tx_block.dest_addr_adj = DMA_ADDR_ADJ_NO_CHANGE;
+	tx_cfg.dma_slot = RPI_PICO_DMA_SLOT_I2C0_TX;
+	tx_cfg.channel_direction = MEMORY_TO_PERIPHERAL;
+	tx_cfg.source_data_size = 2;
+	tx_cfg.dest_data_size = 2;
+	tx_cfg.block_count = 1;
+	tx_cfg.head_block = &tx_block;
+	tx_cfg.dma_callback = i2c_dw_rp2040_dma_callback;
+	tx_cfg.user_data = dw;
+	rx_block.source_address = base + DW_IC_REG_DATA_CMD;
+	rx_block.dest_address = (uintptr_t)rp2040_dma_buffer;
+	rx_block.block_size = msg->len;
+	rx_block.source_addr_adj = DMA_ADDR_ADJ_NO_CHANGE;
+	rx_block.dest_addr_adj = DMA_ADDR_ADJ_INCREMENT;
+	rx_cfg.dma_slot = RPI_PICO_DMA_SLOT_I2C0_RX;
+	rx_cfg.channel_direction = PERIPHERAL_TO_MEMORY;
+	rx_cfg.source_data_size = 1;
+	rx_cfg.dest_data_size = 1;
+	rx_cfg.block_count = 1;
+	rx_cfg.head_block = &rx_block;
+	rx_cfg.dma_callback = i2c_dw_rp2040_dma_callback;
+	rx_cfg.user_data = dw;
+	ret = dma_config(dma, tx, &tx_cfg);
+	if (!ret) {
+		ret = dma_config(dma, rx, &rx_cfg);
+	}
+	if (ret) {
+		atomic_inc(&rp2040_dma_fallbacks);
+		ret = -EAGAIN;
+		goto release;
+	}
+	atomic_set(&rp2040_dma_events, 0);
+	k_sem_reset(&rp2040_dma_sem);
+	atomic_set(&dw->rp2040_dma_active, 1);
+	sys_write32(8, base + 0x8c); /* TX FIFO threshold */
+	sys_write32(0, base + 0x90); /* RX FIFO threshold */
+	write_intr_mask(DW_INTR_STAT_STOP_DET | DW_INTR_STAT_TX_ABRT | DW_INTR_STAT_TX_OVER |
+				DW_INTR_STAT_RX_OVER | DW_INTR_STAT_RX_UNDER |
+				DW_INTR_STAT_SCL_STUCK_LOW,
+			base);
+	started = true;
+	ret = dma_start(dma, rx);
+	if (!ret) {
+		ret = dma_start(dma, tx);
+	}
+	if (!ret) {
+		k_timepoint_t deadline = sys_timepoint_calc(rom->transfer_timeout);
+		write_dma_cr(3, base);
+		while ((atomic_get(&rp2040_dma_events) & RP2040_DMA_DONE) != RP2040_DMA_DONE) {
+			if (atomic_get(&rp2040_dma_events) & RP2040_DMA_ERROR) {
+				ret = -EIO;
+				break;
+			}
+			if (k_sem_take(&rp2040_dma_sem, sys_timepoint_timeout(deadline))) {
+				ret = -ETIMEDOUT;
+				break;
+			}
+		}
+		if (atomic_get(&rp2040_dma_events) & RP2040_DMA_ERROR) {
+			ret = -EIO;
+		}
+	}
+	write_dma_cr(0, base);
+	write_intr_mask(0, base);
+	atomic_set(&dw->rp2040_dma_active, 0);
+	if (ret) {
+		set_bit_enable_abort(base);
+	}
+	if (ret && !i2c_dw_rp2040_dma_stop(dma, tx, rx)) {
+		dw->rp2040_dma_quarantined = true;
+		atomic_inc(&rp2040_dma_errors);
+		LOG_ERR("DMA channels did not stop; I2C controller quarantined");
+		return -EIO;
+	}
+	(void)read_clr_intr(base);
+	if (ret) {
+		int64_t abort_deadline = k_uptime_get() + 100;
+		while (test_bit_enable_abort(base)) {
+			if (k_uptime_get() >= abort_deadline) {
+				dw->rp2040_dma_quarantined = true;
+				LOG_ERR("I2C abort did not finish; controller quarantined");
+				break;
+			}
+			k_sleep(K_MSEC(1));
+		}
+		(void)read_clr_intr(base);
+	}
+	if (!ret) {
+		atomic_inc(&rp2040_dma_transfers);
+		atomic_add(&rp2040_dma_bytes, msg->len);
+		memcpy(msg->buf, rp2040_dma_buffer, msg->len);
+		dw->xfr_len = 0;
+	}
+release:
+	if (ret && ret != -EAGAIN) {
+		atomic_inc(&rp2040_dma_errors);
+	}
+	if (!started || !dw->rp2040_dma_quarantined) {
+		dma_release_channel(dma, tx);
+		dma_release_channel(dma, rx);
+	}
+	return ret;
+}
+
+/* <zephyr/drivers/i2c/i2c_dw_rp2040_dma.h>: the same functions as the I2C0
+ * driver of this workspace's other builds.
+ */
+void i2c_dw_rp2040_dma_get_stats(struct i2c_dw_rp2040_dma_stats *stats)
+{
+	stats->transfers = (uint32_t)atomic_get(&rp2040_dma_transfers);
+	stats->bytes = (uint32_t)atomic_get(&rp2040_dma_bytes);
+	stats->errors = (uint32_t)atomic_get(&rp2040_dma_errors);
+	stats->fallbacks = (uint32_t)atomic_get(&rp2040_dma_fallbacks);
+}
+
+bool i2c_dw_rp2040_dma_enabled(void)
+{
+	return atomic_get(&rp2040_dma_enabled) != 0;
+}
+
+void i2c_dw_rp2040_dma_set_enabled(bool enabled)
+{
+	atomic_set(&rp2040_dma_enabled, enabled ? 1 : 0);
+}
+
+#endif /* ZEPHYR_DRIVERS_I2C_I2C_DW_RP2040_DMA_PRIV_H_ */
