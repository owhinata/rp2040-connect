mainmenu "USB console"
source "Kconfig.zephyr"

config I2C_DW_RP2040_DMA
	bool "RP2040 I2C0 DMA reads"
	depends on SOC_RP2040 && I2C_DW && DMA_RPI_PICO && SHELL && !SMP
	depends on !I2C_DW_LPSS_DMA

config WIFI_NINA_LOCAL
	bool "NINA SPI Wi-Fi offload"
	default y
	select NET_L2_WIFI_MGMT
	select WIFI_OFFLOAD
	select NET_SOCKETS
	select NET_SOCKETS_OFFLOAD

config NINA_SPI_FREQUENCY
	int "NINA SPI frequency in Hz"
	default 8000000
	range 1000000 10000000
	depends on WIFI_NINA_LOCAL

config NINA_TCP_MAX_IO
	int "Maximum bytes per NINA TCP send"
	default 3584
	range 1 3584
	depends on WIFI_NINA_LOCAL
	help
	  Bounds each TCP send to leave room for framing in the NINA SPI
	  command buffer. A RAW batch of up to 2448 bytes plus its MQTT
	  header is sent in one command with the default.

config NINA_SEND_RETRY_MS
	int "Delay before retrying a full NINA TCP send buffer"
	default 1
	range 1 1000
	depends on WIFI_NINA_LOCAL

config NINA_NTP_SERVER
	string "NTP server hostname or IPv4 address"
	default ""
	depends on WIFI_NINA_LOCAL
	help
	  Empty uses the default gateway, normally the PC that provides the
	  Wi-Fi network and runs an NTP server for the board.

config NINA_NTP_PORT
	int "NTP server UDP port"
	default 123
	range 1 65535
	depends on WIFI_NINA_LOCAL

config NINA_NTP_INTERVAL_MS
	int "Interval between NTP queries in milliseconds"
	default 2000
	range 250 3600000
	depends on WIFI_NINA_LOCAL
	help
	  Queries go to a server on the local network. Do not point short
	  intervals at public servers.
