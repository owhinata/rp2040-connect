mainmenu "USB console"
source "Kconfig.zephyr"

config I2C_DW_RP2040_DMA
	bool "RP2040 I2C0 DMA reads"
	depends on SOC_RP2040 && I2C_DW && DMA_RPI_PICO && SHELL && !SMP
	depends on !I2C_DW_LPSS_DMA

config NANO_ROM_MEM_OPS
	bool "memcpy() and memset() through the RP2040 bootrom"
	default y
	depends on SOC_RP2040
	help
	  Wrap memcpy(), memset(), __aeabi_memcpy*() and __aeabi_memset*()
	  (the linker's --wrap) to the bootrom's routines, as the Pico SDK's
	  pico_mem_ops does (common/drivers/rp2040_rom). Without it they are
	  picolibc's byte loops. The early boot's arch_early_memcpy() and
	  arch_early_memset() keep picolibc's (src/rom_mem_early.c).

config NANO_HW_DIVIDER
	bool "Integer division through the RP2040 hardware divider"
	default y
	depends on SOC_RP2040 && !SMP
	select ARM_RP2040_DIVIDER_SAVE
	help
	  Wrap __aeabi_idiv(), __aeabi_idivmod(), __aeabi_uidiv(),
	  __aeabi_uidivmod(), __aeabi_ldivmod() and __aeabi_uldivmod() (the
	  linker's --wrap) to the Pico SDK's pico_divider routines
	  (divider_hardware.S of hal_rpi_pico), which use the SIO divider.
	  Without it they are libgcc's shift-and-subtract loops. The routines
	  save the divider around their use when they interrupt another
	  division; the thread switches save and restore it
	  (ARM_RP2040_DIVIDER_SAVE, a local patch of Zephyr applied by
	  script/setup.sh).

config WIFI_NINA_LOCAL
	bool "NINA SPI Wi-Fi offload"
	default y
	select NET_L2_WIFI_MGMT
	select WIFI_OFFLOAD
	select NET_SOCKETS
	select NET_SOCKETS_OFFLOAD

config NINA_SPI_FREQUENCY
	int "NINA SPI frequency in Hz"
	default 8000000
	range 1000000 10000000
	depends on WIFI_NINA_LOCAL

config NINA_TCP_MAX_IO
	int "Maximum bytes per NINA TCP send"
	default 3584
	range 1 3584
	depends on WIFI_NINA_LOCAL
	help
	  Bounds each TCP send to leave room for framing in the NINA SPI
	  command buffer. A RAW batch of up to 2448 bytes plus its MQTT
	  header is sent in one command with the default.

config NINA_SEND_RETRY_MS
	int "Delay before retrying a full NINA TCP send buffer"
	default 1
	range 1 1000
	depends on WIFI_NINA_LOCAL

config NINA_NTP_SERVER
	string "NTP server hostname or IPv4 address"
	default ""
	depends on WIFI_NINA_LOCAL
	help
	  Empty uses the default gateway, normally the PC that provides the
	  Wi-Fi network and runs an NTP server for the board.

config NINA_NTP_PORT
	int "NTP server UDP port"
	default 123
	range 1 65535
	depends on WIFI_NINA_LOCAL

config NINA_NTP_INTERVAL_MS
	int "Interval between NTP queries in milliseconds"
	default 2000
	range 250 3600000
	depends on WIFI_NINA_LOCAL
	help
	  Queries go to a server on the local network. Do not point short
	  intervals at public servers.
