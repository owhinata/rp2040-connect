#include <zephyr/dt-bindings/dma/rpi-pico-dma-rp2040.h>
#include <zephyr/dt-bindings/sensor/lsm6dso.h>

/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		rx-fifo-size = <2048>;
	};
};

&dma {
	status = "okay";
};

/* 1 MHz from the start (the board's file has 100 kHz): the LSM6DSOX is
 * alone on this bus, and its FIFO from 833 Hz up fills faster than 100 kHz
 * can empty it, at 6667 Hz faster than 400 kHz can.
 */
&i2c0 {
	clock-frequency = <I2C_BITRATE_FAST_PLUS>;
};

/* The NINA's long transfers through DMA channels 10 (TX) and 11 (RX), which
 * the PL022 driver requests at boot; the I2C0 reads take free channels from
 * channel 0 up.
 */
&spi1 {
	status = "okay";
	dmas = <&dma 10 RPI_PICO_DMA_SLOT_SPI1_TX 0>, <&dma 11 RPI_PICO_DMA_SLOT_SPI1_RX 0>;
	dma-names = "tx", "rx";
};

/* Wide ranges: the noise at 6667 Hz is well above one LSB even here, and a
 * saturated gyro sample cannot be recovered afterwards.
 */
&lsm6dsox {
	accel-range = <LSM6DSO_DT_FS_8G>;
	gyro-range = <LSM6DSO_DT_FS_2000DPS>;
};

&nina_w102 {
	compatible = "arduino,nina-spi";
};

/* Reserve the last two erase sectors for settings; keep the image separate. */
&code_partition {
	reg = <0x100 0xffdf00>;
};

&flash0 {
	partitions {
		storage_partition: partition@ffe000 {
			compatible = "zephyr,mapped-partition";
			reg = <0xffe000 0x2000>;
		};
	};
};
