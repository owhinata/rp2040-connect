#include <zephyr/dt-bindings/sensor/lsm6dso.h>

/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		rx-fifo-size = <2048>;
	};
};

&dma {
	status = "okay";
};

&spi1 {
	status = "okay";
};

/* Wide ranges: the noise at 6667 Hz is well above one LSB even here, and a
 * saturated gyro sample cannot be recovered afterwards.
 */
&lsm6dsox {
	accel-range = <LSM6DSO_DT_FS_8G>;
	gyro-range = <LSM6DSO_DT_FS_2000DPS>;
};

&nina_w102 {
	compatible = "arduino,nina-spi";
};

/* Reserve the last two erase sectors for settings; keep the image separate. */
&code_partition {
	reg = <0x100 0xffdf00>;
};

&flash0 {
	partitions {
		storage_partition: partition@ffe000 {
			compatible = "zephyr,mapped-partition";
			reg = <0xffe000 0x2000>;
		};
	};
};
