+// Before Wi-Fi is stopped or reconfigured: a scan still running is stopped
+// and forgotten.
+void WiFiClass::cancelScan()
+{
+  if (_scanState == NINA_SCAN_RUNNING) {
+    esp_wifi_scan_stop();
+  }
+  _scanState = NINA_SCAN_IDLE;
+}
