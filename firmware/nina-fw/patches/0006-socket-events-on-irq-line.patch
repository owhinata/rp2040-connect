@@ -3008,10 +3024,259 @@ CommandHandlerClass::CommandHandlerClass()
 
 static const int GPIO_IRQ = 0;
 
+//
+// Socket events on the IRQ line (GPIO0, the host's GPIO2)
+//
+// A BSD-style socket command that shows the host waiting for a socket arms
+// that event (SocketEvents.h: poll without data, recv/accept with nothing,
+// send that took nothing, connect in progress). The task socketEvents()
+// waits for the armed events with select(); the first one it sees is
+// disarmed and raises the line, which stays high until the next command
+// begins: handle() lowers it before running the command and arms after, so
+// an event after the command's own answer always raises the line again.
+// The line is high while either this or the older sockets' check
+// (updateGpio0Pin()) says so.
+//
+// Locking: evLock (a mutex) covers the table, the line's state and the
+// pin. A socket is closed (close command, Wi-Fi disconnection) only after
+// it is disarmed and, if the task's select() has it, after select() has
+// returned (forgetSocket()).
+
+#define EV_MIN_HIGH_US 5          // shortest time the line stays high
+#define EV_SELECT_TIMEOUT_S 1     // select() looks at the table again after this
+#define EV_CLOSE_WAIT_MS 1000     // longest wait of a close for select() to return
+
+static SemaphoreHandle_t evLock;
+static SemaphoreHandle_t evLeftSelect;   // given once per waiting close
+static struct sockev_table evTable;
+static uint32_t evSelected;              // sockets in the select() running now
+static int evCloseWaiters;
+static bool evPending;                   // an event was seen since the last command began
+static bool evOldAvailable;              // updateGpio0Pin()'s answer
+static int64_t evRaisedAt;
+static int evWakeFd = -1;
+
+static bool socketEventsReady(void)
+{
+  return evWakeFd >= 0;
+}
+
+// With evLock held.
+static void evWritePin(void)
+{
+  digitalWrite(GPIO_IRQ, (evPending || evOldAvailable) ? HIGH : LOW);
+}
+
+static void evWake(void)
+{
+  uint64_t one = 1;
+
+  if (evWakeFd >= 0) {
+    write(evWakeFd, &one, sizeof(one));
+  }
+}
+
+static void evSetOldAvailable(bool available)
+{
+  if (!evLock) {
+    digitalWrite(GPIO_IRQ, available ? HIGH : LOW);
+    return;
+  }
+  xSemaphoreTake(evLock, portMAX_DELAY);
+  evOldAvailable = available;
+  evWritePin();
+  xSemaphoreGive(evLock);
+}
+
+// Before socket FD is closed: no more events for it, and no select() on it.
+static void forgetSocket(int fd)
+{
+  int index = sockev_index(fd, LWIP_SOCKET_OFFSET, MAX_SOCKETS);
+  bool wait;
+
+  if (index < 0 || !evLock) {
+    return;
+  }
+  xSemaphoreTake(evLock, portMAX_DELAY);
+  sockev_disarm(&evTable, index);
+  wait = (evSelected & (1u << index)) != 0;
+  if (wait) {
+    evCloseWaiters++;
+  }
+  xSemaphoreGive(evLock);
+  if (wait) {
+    evWake();
+    xSemaphoreTake(evLeftSelect, pdMS_TO_TICKS(EV_CLOSE_WAIT_MS));
+  }
+}
+
+static void socketEventsBefore(const uint8_t command[])
+{
+  if (!evLock) {
+    return;
+  }
+  xSemaphoreTake(evLock, portMAX_DELAY);
+  if (evPending) {
+    int64_t high = esp_timer_get_time() - evRaisedAt;
+
+    if (high < EV_MIN_HIGH_US) {
+      esp_rom_delay_us(EV_MIN_HIGH_US - high);
+    }
+    evPending = false;
+    evWritePin();
+  }
+  xSemaphoreGive(evLock);
+
+  if (command[1] == 0x71) {
+    forgetSocket(command[4]);
+  }
+}
+
+static void socketEventsAfter(const uint8_t command[], const uint8_t response[], int err)
+{
+  struct sockev_action action;
+  int index;
+  bool added = false;
+
+  if (!evLock) {
+    return;
+  }
+  action = sockev_after_command(command, response, err);
+  index = sockev_index(action.fd, LWIP_SOCKET_OFFSET, MAX_SOCKETS);
+  if (index < 0) {
+    return;
+  }
+  xSemaphoreTake(evLock, portMAX_DELAY);
+  if (action.forget) {
+    sockev_disarm(&evTable, index);
+  }
+  if (action.arm) {
+    added = sockev_arm(&evTable, index, action.arm);
+  }
+  xSemaphoreGive(evLock);
+  if (added) {
+    evWake();
+  }
+}
+
+static void socketEvents(void*)
+{
+  for (;;) {
+    fd_set rset, wset, xset;
+    uint32_t selected = 0;
+    int maxfd = evWakeFd;
+    bool fired = false;
+    int waiters;
+
+    FD_ZERO(&rset);
+    FD_ZERO(&wset);
+    FD_ZERO(&xset);
+    FD_SET(evWakeFd, &rset);
+
+    xSemaphoreTake(evLock, portMAX_DELAY);
+    for (int i = 0; i < MAX_SOCKETS; i++) {
+      uint8_t armed = sockev_armed(&evTable, i);
+      int fd = LWIP_SOCKET_OFFSET + i;
+
+      if (!armed) {
+        continue;
+      }
+      if (armed & SOCKEV_READ) {
+        FD_SET(fd, &rset);
+      }
+      if (armed & SOCKEV_WRITE) {
+        FD_SET(fd, &wset);
+      }
+      FD_SET(fd, &xset);
+      selected |= 1u << i;
+      if (fd > maxfd) {
+        maxfd = fd;
+      }
+    }
+    evSelected = selected;
+    xSemaphoreGive(evLock);
+
+    // The VFS select(): the sockets and the eventfd together.
+    struct timeval tv = { .tv_sec = EV_SELECT_TIMEOUT_S, .tv_usec = 0 };
+    int n = esp_vfs_select(maxfd + 1, &rset, &wset, &xset, &tv);
+
+    xSemaphoreTake(evLock, portMAX_DELAY);
+    evSelected = 0;
+    if (n < 0) {
+      // A socket went away under select(): forget every event, and let the
+      // host look at its sockets again (its polls arm them again).
+      if (selected) {
+        evTable.read = 0;
+        evTable.write = 0;
+        fired = true;
+      }
+    } else if (n > 0) {
+      for (int i = 0; i < MAX_SOCKETS; i++) {
+        int fd = LWIP_SOCKET_OFFSET + i;
+
+        if (!(selected & (1u << i))) {
+          continue;
+        }
+        if (sockev_fire(&evTable, i, FD_ISSET(fd, &rset), FD_ISSET(fd, &wset),
+                        FD_ISSET(fd, &xset))) {
+          fired = true;
+        }
+      }
+    }
+    if (fired && !evPending) {
+      evPending = true;
+      evRaisedAt = esp_timer_get_time();
+      evWritePin();
+    }
+    waiters = evCloseWaiters;
+    evCloseWaiters = 0;
+    xSemaphoreGive(evLock);
+
+    while (waiters-- > 0) {
+      xSemaphoreGive(evLeftSelect);
+    }
+    if (n > 0 && FD_ISSET(evWakeFd, &rset)) {
+      uint64_t value;
+
+      read(evWakeFd, &value, sizeof(value));
+    }
+    if (n < 0) {
+      vTaskDelay(1);
+    }
+  }
+}
+
+static void socketEventsBegin(void)
+{
+  esp_vfs_eventfd_config_t config = ESP_VFS_EVENTD_CONFIG_DEFAULT();
+
+  evLock = xSemaphoreCreateMutex();
+  evLeftSelect = xSemaphoreCreateCounting(MAX_SOCKETS + 2, 0);
+  if (!evLock || !evLeftSelect) {
+    evLock = NULL;
+    return;
+  }
+  if (esp_vfs_eventfd_register(&config) != ESP_OK) {
+    return;
+  }
+  int fd = eventfd(0, 0);
+
+  if (fd < 0) {
+    return;
+  }
+  evWakeFd = fd;
+  if (xTaskCreatePinnedToCore(socketEvents, "socketEvents", 3072, NULL, 2, NULL, 1) != pdPASS) {
+    evWakeFd = -1;
+    close(fd);
+  }
+}
+
 void CommandHandlerClass::begin()
 {
   pinMode(GPIO_IRQ, OUTPUT);
 
+  socketEventsBegin();
+
   for (int i = 0; i < MAX_SOCKETS; i++) {
     socketTypes[i] = 255;
   }
@@ -3035,7 +3300,9 @@ int CommandHandlerClass::handle(const uint8_t command[], uint8_t response[])
     CommandHandlerType commandHandlerType = commandHandlers[command[1]];
 
     if (commandHandlerType) {
+      socketEventsBefore(command);
       responseLength = commandHandlerType(command, response);
+      socketEventsAfter(command, response, errno);
     }
   }
 
@@ -3096,11 +3363,7 @@ void CommandHandlerClass::updateGpio0Pin()
     }
   }
 
-  if (available) {
-    digitalWrite(GPIO_IRQ, HIGH);
-  } else {
-    digitalWrite(GPIO_IRQ, LOW);
-  }
+  evSetOldAvailable(available);
 
   vTaskDelay(1);
 }
@@ -3136,6 +3399,7 @@ void CommandHandlerClass::handleWiFiDisconnect()
 
     if (addr.sin_addr.s_addr != 0) {
       // non-listening socket, close
