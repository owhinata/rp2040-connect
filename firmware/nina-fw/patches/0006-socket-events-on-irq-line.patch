diff --git a/main/SocketEvents.c b/main/SocketEvents.c
new file mode 100644
index 0000000..f0daa20
--- /dev/null
+++ b/main/SocketEvents.c
@@ -0,0 +1,166 @@
+/* SPDX-License-Identifier: MIT */
+/* See SocketEvents.h. */
+
+#include <errno.h>
+
+#include "SocketEvents.h"
+
+#define CMD_SOCKET   0x70
+#define CMD_CLOSE    0x71
+#define CMD_ERRNO    0x72
+#define CMD_ACCEPT   0x75
+#define CMD_CONNECT  0x76
+#define CMD_SEND     0x77
+#define CMD_RECV     0x78
+#define CMD_SENDTO   0x79
+#define CMD_RECVFROM 0x7A
+#define CMD_POLL     0x7C
+#define CMD_LAST     0x7F
+
+/* socket_poll()'s flags (CommandHandler.cpp). */
+#define POLL_RD   0x01
+#define POLL_WR   0x02
+#define POLL_FAIL 0x80
+
+/* The firmware's "no socket" (socket and accept report -1 as 255). */
+#define NO_SOCKET 255
+
+int sockev_index(int fd, int first, int count)
+{
+  if (fd < first || fd >= first + count || count > 32) {
+    return -1;
+  }
+  return fd - first;
+}
+
+int sockev_command_socket(const uint8_t command[])
+{
+  uint8_t cmd = command[1];
+
+  if (cmd <= CMD_SOCKET || cmd > CMD_LAST || cmd == CMD_ERRNO) {
+    return -1;
+  }
+  return (cmd == CMD_SEND || cmd == CMD_SENDTO) ? command[5] : command[4];
+}
+
+static bool would_block(int err)
+{
+  return err == EAGAIN || err == EWOULDBLOCK;
+}
+
+struct sockev_action sockev_after_command(const uint8_t command[], const uint8_t response[],
+                                          int err)
+{
+  struct sockev_action action = {-1, 0, false};
+  uint8_t cmd = command[1];
+  unsigned int count;
+
+  if (cmd == CMD_SOCKET) {
+    if (response[4] != NO_SOCKET) {
+      action.fd = response[4];
+      action.forget = true;
+    }
+    return action;
+  }
+
+  action.fd = sockev_command_socket(command);
+  if (action.fd < 0) {
+    return action;
+  }
+
+  switch (cmd) {
+  case CMD_POLL:
+    if (!(response[4] & POLL_FAIL)) {
+      if (!(response[4] & POLL_RD)) {
+        action.arm |= SOCKEV_READ;
+      }
+      if (!(response[4] & POLL_WR)) {
+        action.arm |= SOCKEV_WRITE;
+      }
+    }
+    break;
+  case CMD_RECV:
+    count = ((unsigned int)response[3] << 8) | response[4];
+    if (count == 0 && would_block(err)) {
+      action.arm = SOCKEV_READ;
+    }
+    break;
+  case CMD_RECVFROM:
+    count = ((unsigned int)response[13] << 8) | response[14];
+    if (count == 0 && would_block(err)) {
+      action.arm = SOCKEV_READ;
+    }
+    break;
+  case CMD_ACCEPT:
+    if (response[4] == NO_SOCKET && would_block(err)) {
+      action.arm = SOCKEV_READ;
+    }
+    break;
+  case CMD_SEND:
+  case CMD_SENDTO:
+    count = ((unsigned int)response[4] << 8) | response[5];
+    if (count == 0 && (would_block(err) || err == ENOMEM)) {
+      action.arm = SOCKEV_WRITE;
+    }
+    break;
+  case CMD_CONNECT:
+    if (response[4] == 0 && (err == EINPROGRESS || err == EALREADY)) {
+      action.arm = SOCKEV_WRITE;
+    }
+    break;
+  default:
+    break;
+  }
+  if (!action.arm) {
+    action.fd = -1;
+  }
+  return action;
+}
+
+bool sockev_arm(struct sockev_table *table, int index, uint8_t events)
+{
+  uint32_t bit = (uint32_t)1 << index;
+  bool added = false;
+
+  if ((events & SOCKEV_READ) && !(table->read & bit)) {
+    table->read |= bit;
+    added = true;
+  }
+  if ((events & SOCKEV_WRITE) && !(table->write & bit)) {
+    table->write |= bit;
+    added = true;
+  }
+  return added;
+}
+
+void sockev_disarm(struct sockev_table *table, int index)
+{
+  uint32_t bit = (uint32_t)1 << index;
+
+  table->read &= ~bit;
+  table->write &= ~bit;
+}
+
+uint8_t sockev_armed(const struct sockev_table *table, int index)
+{
+  uint32_t bit = (uint32_t)1 << index;
+
+  return ((table->read & bit) ? SOCKEV_READ : 0) | ((table->write & bit) ? SOCKEV_WRITE : 0);
+}
+
+uint8_t sockev_fire(struct sockev_table *table, int index, bool readable, bool writable,
+                    bool exception)
+{
+  uint32_t bit = (uint32_t)1 << index;
+  uint8_t fired = 0;
+
+  if ((table->read & bit) && (readable || exception)) {
+    table->read &= ~bit;
+    fired |= SOCKEV_READ;
+  }
+  if ((table->write & bit) && (writable || exception)) {
+    table->write &= ~bit;
+    fired |= SOCKEV_WRITE;
+  }
+  return fired;
+}
diff --git a/main/SocketEvents.h b/main/SocketEvents.h
new file mode 100644
index 0000000..a24f84f
--- /dev/null
+++ b/main/SocketEvents.h
@@ -0,0 +1,82 @@
+/* SPDX-License-Identifier: MIT */
+/* The bookkeeping of the socket events on the IRQ line (GPIO0), without
+ * ESP-IDF: which BSD-style socket command (0x70..0x7F) arms which event of
+ * which socket, and the table of armed events.  CommandHandler.cpp keeps
+ * the table under its lock, waits for the events with select() and drives
+ * the line; firmware/nina-fw/tests/ builds this file on the host.
+ *
+ * An event is armed when a command shows that the host waits for it, and
+ * is armed once: the first time select() reports it, it is disarmed (and
+ * the line raised) until a later command arms it again.
+ */
+
+#ifndef SOCKET_EVENTS_H
+#define SOCKET_EVENTS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SOCKEV_READ  0x01 /* readable: data, a connection to accept, the end, an error */
+#define SOCKEV_WRITE 0x02 /* writable: room to send, a connection made, an error */
+
+/* One bit per socket (index = descriptor - first descriptor). */
+struct sockev_table {
+  uint32_t read;
+  uint32_t write;
+};
+
+/* What a command asks for after it ran: arm EVENTS of socket FD, or
+ * forget FD (a new socket: nothing left from an earlier one). */
+struct sockev_action {
+  int fd;          /* -1: none */
+  uint8_t arm;     /* SOCKEV_* */
+  bool forget;
+};
+
+/* The table index of descriptor FD, or -1 outside FIRST..FIRST+COUNT-1. */
+int sockev_index(int fd, int first, int count);
+
+/* The socket a command names: COMMAND[4], or COMMAND[5] for send (0x77)
+ * and sendto (0x79), whose parameters have 16-bit lengths; -1 for other
+ * commands and for socket (0x70) and errno (0x72), which name none. */
+int sockev_command_socket(const uint8_t command[]);
+
+/* After a command ran, from its command and response buffers and the
+ * errno it left (ERR):
+ *   poll    (0x7C)  READ if not readable, WRITE if not writable (none on
+ *                   its failure flag 0x80)
+ *   recv    (0x78), recvfrom (0x7A), accept (0x75)
+ *                   READ when nothing came and ERR is EAGAIN/EWOULDBLOCK
+ *   send    (0x77), sendto (0x79)
+ *                   WRITE when nothing was taken and ERR is EAGAIN,
+ *                   EWOULDBLOCK or ENOMEM
+ *   connect (0x76)  WRITE when it failed with EINPROGRESS or EALREADY
+ *   socket  (0x70)  forget the new socket's events
+ * Anything else: none.  close (0x71) is handled before the command runs
+ * (sockev_command_socket()). */
+struct sockev_action sockev_after_command(const uint8_t command[], const uint8_t response[],
+                                          int err);
+
+/* Arms EVENTS of socket INDEX; returns true if an event was not armed. */
+bool sockev_arm(struct sockev_table *table, int index, uint8_t events);
+
+void sockev_disarm(struct sockev_table *table, int index);
+
+/* The armed events of socket INDEX. */
+uint8_t sockev_armed(const struct sockev_table *table, int index);
+
+/* What select() said of socket INDEX: the armed events it reports (READ:
+ * readable or an exception; WRITE: writable or an exception), which are
+ * disarmed. */
+uint8_t sockev_fire(struct sockev_table *table, int index, bool readable, bool writable,
+                    bool exception);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SOCKET_EVENTS_H */
